<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- тёмная тема без панели действий: фон окна совпадает с фоном карты, без белой вспышки при запуске -->
    <style name="RadarTheme" parent="@style/Theme.AppCompat.NoActionBar">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@drawable/splash_screen</item>
        <item name="android:statusBarColor">#07090C</item>
        <item name="android:navigationBarColor">#07090C</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
