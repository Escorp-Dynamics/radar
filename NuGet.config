<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- Escorp.Atom 0.10.4: на nuget.org пока только 0.10.3, а пакеты Atom собраны против 0.10.4 — до его публикации лежит здесь -->
    <add key="atom" value="packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="atom">
      <package pattern="Escorp.Atom" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
