<Project Sdk="Microsoft.NET.Sdk">
  <!-- Общая часть приложения: модели, движок, карта, интерфейс. Головы — Radar (десктоп) и Radar.Android -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Radar</RootNamespace>
    <AssemblyName>Radar.Core</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets/Fonts/*.ttf" />
    <AvaloniaResource Include="Assets/radar.png" />
    <!--
      WithCulture="false": иначе MSBuild принимает «.bin» в «basemap.bin.gz» за код культуры (бини) — на Windows такая культура есть,
      и ресурс уезжает в сателлит bin/Radar.Core.resources.dll, а GetManifestResourceStream в основной сборке возвращает null
    -->
    <EmbeddedResource Include="Assets/basemap.bin.gz" LogicalName="Radar.basemap.bin.gz" WithCulture="false" />
    <EmbeddedResource Include="Assets/places.tsv.gz" LogicalName="Radar.places.tsv.gz" WithCulture="false" />
    <EmbeddedResource Include="Assets/labels.bin.gz" LogicalName="Radar.labels.bin.gz" WithCulture="false" />
    <EmbeddedResource Include="Assets/routes.bin.gz" LogicalName="Radar.routes.bin.gz" WithCulture="false" Condition="Exists('Assets/routes.bin.gz')" />
    <EmbeddedResource Include="Assets/roadgraph.bin.gz" LogicalName="Radar.roadgraph.bin.gz" WithCulture="false" Condition="Exists('Assets/roadgraph.bin.gz')" />
    <EmbeddedResource Include="Assets/replay.tsv.gz" LogicalName="Radar.replay.tsv.gz" WithCulture="false" />
  </ItemGroup>

  <!-- Локализованных ресурсов в приложении нет: ресурс в сателлитной сборке — ошибка сборки, а не падение на старте у клиента -->
  <Target Name="RadarNoSatelliteResources" AfterTargets="SplitResourcesByCulture">
    <Error Condition="'@(EmbeddedResource->WithMetadataValue('WithCulture','true'))' != ''"
           Text="Ресурс принят за локализованный и уйдёт в сателлитную сборку: @(EmbeddedResource->WithMetadataValue('WithCulture','true')). Добавьте WithCulture=&quot;false&quot;." />
  </Target>

  <!--
    Отпечаток движка для кеша статистики архива: git-деревья кода разбора и движка (+ незакоммиченные правки в них).
    Пересборка без правок этих файлов (интерфейс, карта) кеш не сбрасывает, а CI и релиз из одного кода дают один отпечаток —
    поэтому статистика, посчитанная в CI, подходит клиентам. Без git — отпечаток сборки (кеш живёт до пересборки).
  -->
  <Target Name="RadarEngineStamp" BeforeTargets="GetAssemblyAttributes">
    <Exec Command="git rev-parse HEAD:./Services HEAD:./Models HEAD:./Map/Basemap.cs HEAD:./Assets" WorkingDirectory="$(MSBuildProjectDirectory)"
          ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RadarEngineTrees" />
      <Output TaskParameter="ExitCode" PropertyName="_RadarEngineTreesExit" />
    </Exec>
    <Exec Condition="'$(_RadarEngineTreesExit)' == '0'" Command="git diff HEAD -- ./Services ./Models ./Map/Basemap.cs ./Assets | git hash-object --stdin"
          WorkingDirectory="$(MSBuildProjectDirectory)" ConsoleToMSBuild="true" IgnoreExitCode="true" EchoOff="true"
          StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ConsoleOutput" PropertyName="_RadarEngineDirty" />
    </Exec>
    <ItemGroup Condition="'$(_RadarEngineTreesExit)' == '0'">
      <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>RadarEngineStamp</_Parameter1>
        <_Parameter2>$(_RadarEngineTrees);$(_RadarEngineDirty)</_Parameter2>
      </AssemblyAttribute>
    </ItemGroup>
  </Target>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.3" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.3" />
    <!-- карта рисуется напрямую через Skia (пути, шейдеры) -->
    <PackageReference Include="Avalonia.Skia" Version="12.1.3" />
    <!-- ротатор бесплатных прокси (фреймворк Atom, пакеты в ../packages): Telegram без VPN там, где t.me заблокирован -->
    <PackageReference Include="Escorp.Atom.Web.Services.Proxies" Version="0.0.1" />
    <!-- зависимости Atom ссылаются на 0.10.3, а собраны против 0.10.4 — версия закреплена явно -->
    <PackageReference Include="Escorp.Atom" Version="0.10.4" />
  </ItemGroup>
</Project>
