<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Radar.ViewModels"
        xmlns:m="using:Radar.Models"
        xmlns:map="using:Radar.Map"
        xmlns:v="using:Radar.Views"
        x:Class="Radar.Views.MainView"
        x:DataType="vm:MainViewModel"
        Background="#07090C">

    <UserControl.Resources>
        <!-- общая мягкая тень всех стеклянных панелей над картой -->
        <!-- шрифт заголовков: Exo 2 (названия регионов, заголовки карточек и разделов) -->
        <FontFamily x:Key="HeadFont">avares://Radar.Core/Assets/Fonts#Exo 2</FontFamily>
        <BoxShadows x:Key="PanelShadow">-6 0 26 0 #66000000, 0 0 8 0 #33000000</BoxShadows>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#B4BECB" />
        </Style>
        <!-- Типографика прибора: микроподписи разрядкой, цифры — табличные -->
        <Style Selector="TextBlock.label">
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="2" />
            <Setter Property="Foreground" Value="#6A7686" />
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="Light" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="Foreground" Value="#EEF3F8" />
        </Style>
        <Style Selector="TextBlock.tel">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="MinWidth" Value="16" />
            <Setter Property="TextAlignment" Value="Left" />
            <Setter Property="Foreground" Value="#EEF3F8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- разделители в заголовке: сплошные, на всю высоту, той же толщины и цвета, что рамка окна -->
        <Style Selector="Rectangle.sep">
            <Setter Property="Width" Value="1" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Fill" Value="#26FFFFFF" />
        </Style>
        <!-- индикатор связи: мигает в реальном времени, серый и неподвижный без связи. Пульс задаёт таймер окна
             (~8 кадров/с): анимация стиля пересчитывалась 60 раз в секунду и с каждым кадром перерисовывала
             пересекающийся с точкой кусок окна вместе с эффектами карты — это была основная нагрузка в простое -->
        <Style Selector="Ellipse.live">
            <Setter Property="Fill" Value="#FF4D5A" />
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Fill" Duration="0:0:0.8" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Ellipse.live.connecting">
            <Setter Property="Fill" Value="#7CD4FF" />
        </Style>
        <Style Selector="Ellipse.live.offline">
            <Setter Property="Fill" Value="#5C6878" />
        </Style>
        <Style Selector="TextBlock.live">
            <Setter Property="Foreground" Value="#FF8A93" />
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.8" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="TextBlock.live.connecting">
            <Setter Property="Foreground" Value="#9FD8F5" />
        </Style>
        <Style Selector="TextBlock.live.offline">
            <Setter Property="Foreground" Value="#6A7686" />
        </Style>
        <!-- счётчик группы угроз: иконка цвета группы, наклонённая вправо на 45°, и число -->
        <Style Selector="StackPanel.telk">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="3" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="ClipToBounds" Value="True" />
            <!-- группа без активных угроз схлопывается: ширина, отступ и прозрачность анимируются -->
            <Setter Property="MaxWidth" Value="0" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="MaxWidth" Duration="0:0:0.35" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.35" Easing="CubicEaseOut" />
                    <ThicknessTransition Property="Margin" Duration="0:0:0.35" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.telk.on">
            <Setter Property="MaxWidth" Value="64" />
            <Setter Property="Opacity" Value="1" />
            <Setter Property="Margin" Value="4,0" />
        </Style>
        <!-- кнопка группы: прозрачная, подсветка при наведении; скрытая на карте группа приглушена и перечёркнута -->
        <Style Selector="Button.telb">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.35" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.telb.on">
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style Selector="Button.telb:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.telb:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.telb:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="Button.telb.off">
            <Setter Property="Opacity" Value="0.38" />
        </Style>
        <Style Selector="Button.telb.off TextBlock.tel">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <!-- крайние промежутки списка как у соседних счётчиков (16 в полном варианте, 12 в узком), только пока в нём есть группы -->
        <Style Selector="ItemsControl.telks">
            <Setter Property="Transitions">
                <Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.35" Easing="CubicEaseOut" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="ItemsControl.telks.any">
            <Setter Property="Margin" Value="4,0,-4,0" />
        </Style>
        <Style Selector="ItemsControl.telks.wide.any">
            <Setter Property="Margin" Value="8,0,-4,0" />
        </Style>
        <Style Selector="Panel.telkicon">
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Panel.telkicon > Path">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Stretch" Value="Uniform" />
            <Setter Property="RenderTransform" Value="rotate(45deg)" />
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.3" Easing="CubicEaseOut" /></Transitions>
            </Setter>
        </Style>
        <!-- рост счётчика: иконка вспыхивает ореолом своего цвета и на миг увеличивается, число подсвечивается -->
        <Style Selector="Panel.telkicon > Ellipse">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Effect" Value="blur(5)" />
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.45" Easing="CubicEaseOut" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.telk.bump Panel.telkicon > Ellipse">
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="StackPanel.telk.bump Panel.telkicon > Path">
            <Setter Property="RenderTransform" Value="rotate(45deg) scale(1.22)" />
        </Style>
        <Style Selector="StackPanel.telk > TextBlock.tel">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.45" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="StackPanel.telk.bump > TextBlock.tel">
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="StackPanel.telc">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="5" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="StackPanel.telc Path">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="TextBlock.telcap">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="Foreground" Value="#8794A5" />
        </Style>
        <Style Selector="TextBlock.cap">
            <Setter Property="FontSize" Value="8.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LetterSpacing" Value="1.8" />
            <Setter Property="Foreground" Value="#5C6878" />
        </Style>
        <!-- Стеклянные панели над картой: размытие подложки, тонировка, светлая кромка -->
        <Style Selector="v|GlassPanel.panel">
            <Setter Property="Chamfer" Value="10" />
            <Setter Property="Shadow" Value="{StaticResource PanelShadow}" />
        </Style>
        <!-- метка режима в заголовке — кнопка меню режимов -->
        <Style Selector="Button.mode">
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="8,0,10,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.mode:pointerover /template/ ContentPresenter, Button.mode.open /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.mode:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.mode:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="Button.mode Path.chev">
            <Setter Property="Stroke" Value="#6A7686" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.mode:pointerover Path.chev">
            <Setter Property="Stroke" Value="#EEF3F8" />
        </Style>
        <Style Selector="Button.mode.open Path.chev">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
            <Setter Property="Stroke" Value="#7CD4FF" />
        </Style>
        <!-- меню режимов: выезжает из-под заголовка -->
        <Style Selector="Panel.modemenu">
            <Setter Property="ClipToBounds" Value="True" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Panel.modemenu.open">
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Panel.modemenu > v|GlassPanel">
            <Setter Property="RenderTransform" Value="translateY(-180px)" />
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.28" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.22" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Panel.modemenu.open > v|GlassPanel">
            <Setter Property="RenderTransform" Value="none" />
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.modeitem">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,9,14,9" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.modeitem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.modeitem:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.modeitem:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <!-- выбор месяца в панели истории -->
        <!-- выбор месяца, чип региона: тот же контур, что у выпадающего списка -->
        <Style Selector="Button.month">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#3A4654" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <v:HudFrame Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" Accent="#F2C14E" Chamfer="5">
                        <ContentPresenter Name="content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </v:HudFrame>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.month:pointerover">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="Button.month.open">
            <Setter Property="Background" Value="#14F2C14E" />
            <Setter Property="BorderBrush" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.month:disabled">
            <Setter Property="Opacity" Value="0.45" />
        </Style>
        <Style Selector="Button.month:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.month Path.chev">
            <Setter Property="Stroke" Value="#6A7686" />
            <Setter Property="RenderTransform" Value="rotate(0deg)" />
            <Setter Property="Transitions">
                <Transitions><TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.month.open Path.chev">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
            <Setter Property="Stroke" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.modeitem.cur /template/ ContentPresenter">
            <Setter Property="Background" Value="#14F2C14E" />
        </Style>
        <Style Selector="v|GlassPanel.monthpick">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(10px)" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="v|GlassPanel.monthpick.open">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <!-- Кнопки рамки окна -->
        <Style Selector="Button.win">
            <Setter Property="Width" Value="38" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.win Path">
            <Setter Property="Stroke" Value="#8A96A6" />
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.5" /></Transitions>
            </Setter>
        </Style>
        <!-- без связи навигация по карте отключена: значок гаснет и перечёркивается -->
        <Style Selector="Button.win:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.win:disabled Path">
            <Setter Property="Opacity" Value="0.22" />
        </Style>
        <Style Selector="Button.win:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.win:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.win:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="Button.win.close:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#A3222C" />
        </Style>
        <Style Selector="Button.win:pointerover Path">
            <Setter Property="Stroke" Value="#EEF3F8" />
        </Style>
        <Style Selector="Button.win.on Path">
            <Setter Property="Stroke" Value="#7CD4FF" />
        </Style>
        <Style Selector="Button.win.close:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#C42B36" />
        </Style>

        <Style Selector="Button.icon">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.icon:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.icon:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.icon:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="Button.icon Path">
            <Setter Property="Fill" Value="#8C97A7" />
        </Style>
        <Style Selector="Button.icon:pointerover Path">
            <Setter Property="Fill" Value="#BDE9FF" />
        </Style>

        <!-- Счётчики легенды: короткая подсветка при росте числа -->
        <Style Selector="Border.cnt">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="MinWidth" Value="18" />
            <Setter Property="Padding" Value="5,0,5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.6" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.cnt.bump">
            <Setter Property="Background" Value="#557CD4FF" />
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>
        <Style Selector="Border.lvl">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="RenderTransform" Value="scale(1)" />
            <Setter Property="Transitions">
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="BackEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.lvl.bump">
            <Setter Property="RenderTransform" Value="scale(1.15)" />
            <Setter Property="BorderBrush" Value="#CCFFFFFF" />
        </Style>

        <!-- Легенда: заголовок, секции, строки единой сетки (образец 26 · подпись · счётчик) -->
        <Style Selector="TextBlock.lhead">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="#DDE6EF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Grid.lsec">
            <Setter Property="Margin" Value="4,12,0,5" />
        </Style>
        <Style Selector="TextBlock.lsec">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.4" />
            <Setter Property="Foreground" Value="#6E8094" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style Selector="Border.lsec">
            <Setter Property="Height" Value="1" />
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.lrow">
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Border.lrow > Grid, Grid.lrow">
            <Setter Property="MinHeight" Value="20" />
        </Style>
        <!-- низкое окно: легенда плотнее -->
        <Style Selector="v|GlassPanel.compact Grid.lsec">
            <Setter Property="Margin" Value="4,8,0,3" />
        </Style>
        <Style Selector="v|GlassPanel.compact Border.lrow">
            <Setter Property="Padding" Value="4,1" />
        </Style>
        <Style Selector="v|GlassPanel.compact Border.lrow > Grid, v|GlassPanel.compact Grid.lrow">
            <Setter Property="MinHeight" Value="18" />
        </Style>
        <Style Selector="TextBlock.lt">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cn">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <!-- Переключатель «все типы»: как кнопки прибора — без рамки, акцент при включении, риска снизу -->
        <!-- кнопки шапки легенды: одна высота 24, одинаковая подложка при наведении -->
        <Style Selector="Button.lbtn">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.lbtn Path">
            <Setter Property="Stroke" Value="#7A8696" />
        </Style>
        <Style Selector="Button.lbtn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.lbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.lbtn:pointerover Path">
            <Setter Property="Stroke" Value="#BDE9FF" />
        </Style>
        <Style Selector="Button.lbtn:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.lbtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <!-- Нижние панели (загрузка истории, архив): подписи, числа, полоса, кнопки прибора -->
        <Style Selector="TextBlock.psub">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#7F8B9B" />
            <Setter Property="FontFeatures" Value="tnum" />
        </Style>
        <Style Selector="TextBlock.pnum">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontFeatures" Value="tnum" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ProgressBar.pbar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="1" />
            <Setter Property="Height" Value="2" />
            <Setter Property="MinHeight" Value="2" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="Button.pbtn, ToggleButton.pbtn">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.pbtn Path, ToggleButton.pbtn Path">
            <Setter Property="Fill" Value="#8C97A7" />
        </Style>
        <Style Selector="Button.pbtn /template/ ContentPresenter, ToggleButton.pbtn /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.pbtn:pointerover /template/ ContentPresenter, ToggleButton.pbtn:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="Button.pbtn:pointerover Path, ToggleButton.pbtn:pointerover Path">
            <Setter Property="Fill" Value="#BDE9FF" />
        </Style>
        <Style Selector="Button.pbtn:pressed, ToggleButton.pbtn:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.pbtn:pressed /template/ ContentPresenter, ToggleButton.pbtn:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <!-- пауза: акцент архива и риска снизу -->
        <Style Selector="ToggleButton.pbtn:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#14F2C14E" />
            <Setter Property="BorderBrush" Value="#F2C14E" />
        </Style>
        <Style Selector="ToggleButton.pbtn:checked Path">
            <Setter Property="Fill" Value="#F2C14E" />
        </Style>
        <Style Selector="ToggleButton.ltog">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="8,0,9,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ltog TextBlock">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="#7A8696" />
        </Style>
        <Style Selector="ToggleButton.ltog Path">
            <Setter Property="Stroke" Value="#7A8696" />
        </Style>
        <Style Selector="ToggleButton.ltog /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ltog:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.ltog:pointerover TextBlock">
            <Setter Property="Foreground" Value="#BDE9FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:pointerover Path">
            <Setter Property="Stroke" Value="#BDE9FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#127CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#227CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.ltog:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:checked TextBlock">
            <Setter Property="Foreground" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ltog:checked Path">
            <Setter Property="Stroke" Value="#7CD4FF" />
        </Style>

        <!-- Кликабельные элементы легенды -->
        <Style Selector="Button.leg">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="2,1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
        <Style Selector="Button.leg:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="Button.leg:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <!-- кнопка-панель со срезанными углами: подсвечивается само стекло по контуру, без прямоугольной подложки -->
        <Style Selector="Button.leg.glass:pointerover /template/ ContentPresenter, Button.leg.glass:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.leg.glass > v|GlassPanel">
            <Setter Property="Transitions">
                <Transitions><DoubleTransition Property="Highlight" Duration="0:0:0.15" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.leg.glass:pointerover > v|GlassPanel">
            <Setter Property="Highlight" Value="0.102" />
        </Style>
        <Style Selector="Button.leg.glass:pressed > v|GlassPanel">
            <Setter Property="Highlight" Value="0.165" />
        </Style>

        <!-- Фильтры-чипы -->
        <Style Selector="ToggleButton.chip">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="9,3,9,4" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#7A8696" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="ToggleButton.chip:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#807CD4FF" />
            <Setter Property="Foreground" Value="#E6F6FF" />
        </Style>
        <Style Selector="ToggleButton.chip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#4A5564" />
            <Setter Property="Foreground" Value="#A9B4C2" />
        </Style>
        <Style Selector="ToggleButton.chip:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#267CD4FF" />
            <Setter Property="BorderBrush" Value="#B37CD4FF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
        </Style>
        <Style Selector="ToggleButton.chip:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.chip:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.chip /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.12" />
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>

        <!-- Поиск: тёмное поле со значком лупы, тонкая кромка; в фокусе — голубая кромка, крестик очистки -->
        <Style Selector="TextBox.search">
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Padding" Value="6,0,8,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="InnerLeftContent">
                <Template>
                    <Path Width="12" Height="12" Margin="10,0,2,0" Stretch="Uniform" Stroke="#5C6878" StrokeThickness="1.4" StrokeLineCap="Round"
                          VerticalAlignment="Center" Data="M5 0.7 A4.3 4.3 0 1 1 4.99 0.7 Z M8.2 8.2 L11.3 11.3" />
                </Template>
            </Setter>
        </Style>
        <Style Selector="ComboBox, CalendarDatePicker.range">
            <Setter Property="Height" Value="30" />
        </Style>
        <Style Selector="TextBox.search:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="TextBox.search:not(:empty)">
            <Setter Property="InnerRightContent">
                <Template>
                    <Button Classes="icon" Width="28" Height="28" Margin="0,0,2,0" Command="{Binding $parent[TextBox].Clear}" ToolTip.Tip="Очистить поиск">
                        <Path Width="8" Height="8" Stretch="Uniform" Stroke="#8C97A7" StrokeThickness="1.3" StrokeLineCap="Round" Data="M0 0 L8 8 M8 0 L0 8" />
                    </Button>
                </Template>
            </Setter>
        </Style>
        <Style Selector="TextBox.search:not(:empty) Button.icon:pointerover Path">
            <Setter Property="Stroke" Value="#BDE9FF" />
        </Style>

        <!-- Переименование пункта на месте: выглядит как текст; при наведении — кромка и карандаш, в фокусе — поле ввода -->
        <Style Selector="TextBox.rename">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#DDE3EA" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="4,2,4,2" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Cursor" Value="Ibeam" />
            <Setter Property="SelectionBrush" Value="#557CD4FF" />
            <Setter Property="CaretBrush" Value="#7CD4FF" />
            <Setter Property="InnerRightContent">
                <Template>
                    <Path Classes="pen" Width="9" Height="9" Margin="2,0,4,0" Stretch="Uniform" Stroke="#7CD4FF" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                          VerticalAlignment="Center" Data="M1 11 L1.5 8.5 L8.5 1.5 L10.5 3.5 L3.5 10.5 Z M7 3 L9 5" />
                </Template>
            </Setter>
        </Style>
        <Style Selector="TextBox.rename Path.pen">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="TextBox.rename:pointerover Path.pen, TextBox.rename:focus Path.pen">
            <Setter Property="Opacity" Value="0.9" />
        </Style>
        <Style Selector="TextBox.rename /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
        </Style>
        <Style Selector="TextBox.rename:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#0F7CD4FF" />
            <Setter Property="BorderBrush" Value="#337CD4FF" />
        </Style>
        <Style Selector="TextBox.rename:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="#14000000" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <!-- Пустые состояния лент: значок-пиктограмма, заголовок, пояснение, действие -->
        <Style Selector="StackPanel.empty">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,24,32" />
            <Setter Property="MaxWidth" Value="300" />
            <Setter Property="Spacing" Value="8" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="StackPanel.empty">
            <Style.Animations>
                <Animation Duration="0:0:0.4" Easing="CubicEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /><Setter Property="TranslateTransform.Y" Value="6" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /><Setter Property="TranslateTransform.Y" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="Panel.emptyicon">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="Panel.emptyicon Path">
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
        </Style>
        <Style Selector="Path.sweep">
            <!-- полный размер значка 28×28: линия из центра (14,14) вверх вращается вокруг центра колец -->
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Style.Animations>
                <Animation Duration="0:0:2.4" IterationCount="Infinite">
                    <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.emptytitle">
            <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DDE3EA" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="TextBlock.emptytext">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#6B7584" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="17" />
        </Style>
        <Style Selector="Button.emptyaction">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.emptyaction:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.emptyaction:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="Foreground" Value="#EEF3F8" />
        </Style>
        <Style Selector="Button.emptyaction:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>

        <!-- Без связи: баннер выезжает сверху; карта «теряет сигнал» (MapControl.SignalLost) -->
        <Style Selector="v|GlassPanel.offline">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="RenderTransform" Value="translateY(-14px)" />
            <Setter Property="MaxWidth" Value="620" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6" Easing="CubicEaseOut" />
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.6" Easing="CubicEaseOut" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="v|GlassPanel.offline.on">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <!-- Таблица источников -->
        <Style Selector="Border.chrow">
            <Setter Property="Padding" Value="16,10,18,11" />
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Border.chrow:pointerover">
            <Setter Property="Background" Value="#0D7CD4FF" />
        </Style>
        <!-- строка статуса боковой панели -->
        <Style Selector="Border.statusbar">
            <Setter Property="BorderBrush" Value="#14FFFFFF" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="Padding" Value="16,6,16,6" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBlock.stag">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.ssub">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#5E6876" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.serr">
            <Setter Property="BorderBrush" Value="#E5484D" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Background" Value="#1AE5484D" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.serr TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#FF8A93" />
        </Style>
        <!-- вкладка «Настройки»: секции, строки «название + пояснение — переключатель», сегменты и кнопки -->
        <Style Selector="Grid.ssec">
            <Setter Property="Margin" Value="0,16,0,6" />
        </Style>
        <Style Selector="Grid.srow">
            <Setter Property="Margin" Value="0,6" />
            <Setter Property="ColumnSpacing" Value="14" />
        </Style>
        <Style Selector="Grid.srow:disabled, StackPanel.sblock:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="StackPanel.sblock">
            <Setter Property="Margin" Value="0,6" />
        </Style>
        <Style Selector="TextBlock.sname">
            <Setter Property="FontFamily" Value="{StaticResource HeadFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#DDE3EA" />
        </Style>
        <Style Selector="TextBlock.shint">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#6B7584" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="15" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="RadioButton.seg">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bg" Background="Transparent">
                        <TextBlock Name="t" Text="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="10.5" FontWeight="Bold" LetterSpacing="0.8" Foreground="#6E8094" TextTrimming="CharacterEllipsis" />
                    </Border>
                </ControlTemplate>
            </Setter>
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="RadioButton.seg:pointerover /template/ Border#bg">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="RadioButton.seg:focus-visible /template/ Border#bg">
            <Setter Property="BorderBrush" Value="#7CD4FF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="RadioButton.seg:pressed /template/ Border#bg">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#bg">
            <Setter Property="Background" Value="#227CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ TextBlock#t">
            <Setter Property="Foreground" Value="#E6F6FF" />
        </Style>
        <!-- кнопки настроек: контур панелей (срезанные углы, волосяная кромка, акцентная засечка), одна высота -->
        <Style Selector="Button.sbtn">
            <Setter Property="Background" Value="#0AFFFFFF" />
            <Setter Property="BorderBrush" Value="#3A4654" />
            <Setter Property="Foreground" Value="#7CD4FF" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <v:HudFrame Name="frame" Fill="{TemplateBinding Background}" Stroke="{TemplateBinding BorderBrush}" Accent="{TemplateBinding Foreground}" Chamfer="6">
                        <ContentPresenter Name="content" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </v:HudFrame>
                </ControlTemplate>
            </Setter>
        </Style>
        <!-- кнопки справа в строках настроек — одной ширины, столбец ровный -->
        <Style Selector="Grid.srow > Button.sbtn, Grid.srow > StackPanel > Button.sbtn">
            <Setter Property="Width" Value="112" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="Button.sbtn TextBlock">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1" />
            <Setter Property="Foreground" Value="#C6D0DB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sbtn Path">
            <Setter Property="Stroke" Value="#C6D0DB" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.sbtn:pointerover">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="Button.sbtn:pointerover TextBlock">
            <Setter Property="Foreground" Value="#EEF6FF" />
        </Style>
        <Style Selector="Button.sbtn:pressed">
            <Setter Property="Background" Value="#2A7CD4FF" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.sbtn:focus-visible">
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <!-- поддержать разработчика / скачать обновление / активная трансляция: янтарный акцент темы.
             Активное состояние — не заливка, а янтарная кромка, мягкий фон и подсвеченная засечка, как у выбранного в меню -->
        <Style Selector="Button.sbtn.donate, Button.sbtn.amber">
            <Setter Property="BorderBrush" Value="#8F6E2C" />
            <Setter Property="Background" Value="#14F2C14E" />
            <Setter Property="Foreground" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.sbtn.donate">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="Button.sbtn.donate TextBlock, Button.sbtn.amber TextBlock">
            <Setter Property="Foreground" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.sbtn.donate Path">
            <Setter Property="Stroke" Value="{x:Null}" />
            <Setter Property="Fill" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.sbtn.donate:pointerover, Button.sbtn.amber:pointerover">
            <Setter Property="Background" Value="#24F2C14E" />
            <Setter Property="BorderBrush" Value="#F2C14E" />
        </Style>
        <Style Selector="Button.sbtn.donate:pressed, Button.sbtn.amber:pressed">
            <Setter Property="Background" Value="#33F2C14E" />
        </Style>
        <Style Selector="Button.sbtn:disabled">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#262E38" />
            <Setter Property="Foreground" Value="#3A4654" />
        </Style>
        <Style Selector="Button.sbtn:disabled TextBlock">
            <Setter Property="Foreground" Value="#5C6878" />
        </Style>

        <!-- выбор регионов: чипы выбранных, список с отметками -->
        <Style Selector="Button.rchip">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#807CD4FF" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="Margin" Value="0,0,6,6" />
        </Style>
        <Style Selector="Button.rchip TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="#E6F6FF" />
        </Style>
        <Style Selector="Button.rchip Path">
            <Setter Property="Stroke" Value="#9FD8F5" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rchip:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="Button.rchip:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.rpick">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A4452" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rpick Path">
            <Setter Property="Stroke" Value="#B4BECB" />
            <Setter Property="StrokeThickness" Value="1.2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rpick:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.rpick:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.rpick:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.rpick TextBlock">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="#B4BECB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.rpick:checked /template/ ContentPresenter, ToggleButton.rpick:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.rpick:checked TextBlock">
            <Setter Property="Foreground" Value="#E6F6FF" />
        </Style>
        <Style Selector="ToggleButton.rpick:checked Path">
            <Setter Property="Stroke" Value="#7CD4FF" />
        </Style>
        <Style Selector="TextBlock.rkind">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="9" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="#6E8094" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rchip TextBlock.rkind">
            <Setter Property="Foreground" Value="#7CD4FF" />
            <Setter Property="FontSize" Value="9" />
        </Style>
        <Style Selector="TextBlock.rhint">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#6B7584" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="CheckBox.rcheck > Grid TextBlock, CheckBox.rcheck ContentPresenter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Grid.prow">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="ColumnSpacing" Value="4" />
        </Style>
        <Style Selector="Button.rstep">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#3A4452" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rstep Path">
            <Setter Property="Stroke" Value="#B4BECB" />
            <Setter Property="StrokeThickness" Value="1.3" />
            <Setter Property="StrokeLineCap" Value="Round" />
        </Style>
        <Style Selector="Button.rstep:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="BorderBrush" Value="#7CD4FF" />
        </Style>
        <Style Selector="Button.rstep:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="Button.rstep:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="Button.rstep:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#262E38" />
        </Style>
        <Style Selector="Button.rstep:disabled Path">
            <Setter Property="Stroke" Value="#3A4452" />
        </Style>
        <Style Selector="Border.rlist">
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,6,0,0" />
            <Setter Property="Padding" Value="0,2" />
        </Style>
        <Style Selector="CheckBox.rcheck">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,0,0,0" />
            <Setter Property="Margin" Value="8,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#B4BECB" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>
        <Style Selector="CheckBox.rcheck:checked">
            <Setter Property="Foreground" Value="#E6F6FF" />
        </Style>

        <!-- переключатель канала: узкая «дорожка» с бегунком; включён — акцент, выключен — серый -->
        <Style Selector="ToggleButton.chsw">
            <Setter Property="Width" Value="28" />
            <Setter Property="Height" Value="16" />
            <Setter Property="Margin" Value="10,0,0,0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Panel Background="Transparent">
                        <Border Name="track" Height="10" BorderThickness="1" BorderBrush="#3A4452" Background="Transparent" />
                        <Border Name="knob" Width="8" Height="6" HorizontalAlignment="Left" Margin="2,0" Background="#5C6878" />
                    </Panel>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.chsw /template/ Border#knob">
            <Setter Property="Transitions">
                <Transitions>
                    <ThicknessTransition Property="Margin" Duration="0:0:0.18" Easing="CubicEaseOut" />
                    <BrushTransition Property="Background" Duration="0:0:0.18" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.chsw:checked /template/ Border#knob">
            <Setter Property="Margin" Value="18,0,2,0" />
            <Setter Property="Background" Value="#7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.chsw:checked /template/ Border#track">
            <Setter Property="BorderBrush" Value="#807CD4FF" />
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.chsw:pointerover /template/ Border#track">
            <Setter Property="BorderBrush" Value="#BDE9FF" />
        </Style>
        <Style Selector="ToggleButton.chsw:focus-visible /template/ Border#track">
            <Setter Property="BorderBrush" Value="#E6F6FF" />
        </Style>
        <Style Selector="ToggleButton.chsw:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="TextBlock.chstate">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="8,0,0,0" />
        </Style>
        <!-- сообщение канала: полоса цвета распознанной угрозы, канал и время строкой прибора, текст -->
        <Style Selector="Border.msg">
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,11,16,12" />
        </Style>
        <Style Selector="TextBlock.msgch">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.4" />
            <Setter Property="Foreground" Value="#8C97A7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Ellipse.chdot">
            <Setter Property="Width" Value="7" />
            <Setter Property="Height" Value="7" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>
        <Style Selector="Ellipse.chdot.pulse">
            <Style.Animations>
                <Animation Duration="0:0:0.9" IterationCount="Infinite" PlaybackDirection="Alternate">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.25" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>

        <!-- Список тревог -->
        <Style Selector="ListBox.feed">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
        </Style>
        <Style Selector="ListBox.feed ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
        </Style>
        <Style Selector="ListBox.feed ListBoxItem">
            <Style.Animations>
                <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Backward">
                    <KeyFrame Cue="0%">
                        <Setter Property="Opacity" Value="0" />
                        <Setter Property="TranslateTransform.Y" Value="-10" />
                    </KeyFrame>
                    <KeyFrame Cue="100%">
                        <Setter Property="Opacity" Value="1" />
                        <Setter Property="TranslateTransform.Y" Value="0" />
                    </KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Плашка уровня события при повышении: «подпрыгивает» и обводится светлой рамкой -->
        <!-- карточка тревоги в ленте -->
        <Style Selector="Border.card">
            <Setter Property="BorderBrush" Value="#10FFFFFF" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="Padding" Value="16,12,16,13" />
        </Style>
        <!-- тревога в выбранной зоне: голубой фон-градиент от левого края и метка «МОЯ ЗОНА» -->
        <Style Selector="Border.card.mine">
            <Setter Property="Background">
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#1A7CD4FF" />
                    <GradientStop Offset="0.6" Color="#057CD4FF" />
                    <GradientStop Offset="1" Color="#007CD4FF" />
                </LinearGradientBrush>
            </Setter>
        </Style>
        <Style Selector="Border.minetag">
            <Setter Property="BorderBrush" Value="#7CD4FF" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Background" Value="#1A7CD4FF" />
            <Setter Property="Padding" Value="5,2,6,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.minetag TextBlock">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="9.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="#9FD8F5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.minetag Path">
            <Setter Property="Fill" Value="#7CD4FF" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.cardkind">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.9" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.cardstatus">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
        </Style>
        <Style Selector="TextBlock.cardsrc">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="#5E6876" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.lvlup">
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="RenderTransformOrigin" Value="0%,50%" />
        </Style>
        <Style Selector="Border.lvlup.on">
            <Style.Animations>
                <Animation Duration="0:0:1.6" Easing="CubicEaseOut" FillMode="None">
                    <KeyFrame Cue="0%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /><Setter Property="BorderBrush" Value="#00FFFFFF" /></KeyFrame>
                    <KeyFrame Cue="12%"><Setter Property="ScaleTransform.ScaleX" Value="1.18" /><Setter Property="ScaleTransform.ScaleY" Value="1.18" /><Setter Property="BorderBrush" Value="#DDFFFFFF" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="ScaleTransform.ScaleX" Value="1" /><Setter Property="ScaleTransform.ScaleY" Value="1" /><Setter Property="BorderBrush" Value="#00FFFFFF" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <!-- Вспышка нового события в ленте: цвет угрозы, затухает за ~1.8 с -->
        <Style Selector="Border.flash">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.flash.on">
            <Style.Animations>
                <Animation Duration="0:0:1.8" Easing="CubicEaseOut" FillMode="Forward">
                    <KeyFrame Cue="0%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                    <KeyFrame Cue="8%"><Setter Property="Opacity" Value="0.30" /></KeyFrame>
                    <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0" /></KeyFrame>
                </Animation>
            </Style.Animations>
        </Style>
        <Style Selector="TextBlock.num">
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="ListBox.feed ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#0D7CD4FF" />
        </Style>
        <Style Selector="ListBox.feed ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#127CD4FF" />
        </Style>

        <!-- вкладки боковой панели: капс шрифтом прибора, выбранная — светлая с акцентной чертой снизу -->
        <Style Selector="TabControl.side">
            <!-- вкладки делят всю ширину поровну; правый край — тот же отступ 16, что у фильтров и линии под ними -->
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate><UniformGrid Rows="1" Margin="0,0,16,0" /></ItemsPanelTemplate>
            </Setter>
        </Style>
        <Style Selector="TabControl.side TabItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="TabControl.side TabItem /template/ Border#PART_SelectedPipe">
            <Setter Property="Height" Value="1" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="#7CD4FF" />
        </Style>
        <Style Selector="TextBlock.tabh">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="1.2" />
            <Setter Property="Foreground" Value="#6E8094" />
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Foreground" Duration="0:0:0.15" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="TabItem:pointerover TextBlock.tabh">
            <Setter Property="Foreground" Value="#BDE9FF" />
        </Style>
        <Style Selector="TabItem:selected TextBlock.tabh">
            <Setter Property="Foreground" Value="#DDE6EF" />
        </Style>
        <Style Selector="TabControl.side TabItem:pointerover /template/ Border#PART_LayoutRoot, TabControl.side TabItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Rectangle.tabline">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="#14FFFFFF" />
            <Setter Property="VerticalAlignment" Value="Top" />
            <Setter Property="Margin" Value="16,33,16,0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="v|MainView.touch Rectangle.tabline">
            <!-- вкладки на сенсорном экране выше (44): разделитель — по их нижней кромке, под чертой выбранной -->
            <Setter Property="Margin" Value="16,43,16,0" />
        </Style>

        <!-- фильтры ленты: сегмент из пяти переключателей -->
        <Style Selector="Border.near">
            <Setter Property="Background" Value="#0F7CD4FF" />
            <Setter Property="BorderBrush" Value="#557CD4FF" />
            <Setter Property="BorderThickness" Value="1,0,0,0" />
            <Setter Property="Padding" Value="8,3" />
        </Style>
        <Style Selector="Border.near Path">
            <Setter Property="Stroke" Value="#7CD4FF" />
            <Setter Property="StrokeThickness" Value="1.3" />
        </Style>
        <Style Selector="Border.near TextBlock">
            <Setter Property="Foreground" Value="#BFE6FA" />
        </Style>
        <Style Selector="Border.near.on">
            <Setter Property="Background" Value="#26E5484D" />
            <Setter Property="BorderBrush" Value="#E5484D" />
        </Style>
        <Style Selector="Border.near.on Path">
            <Setter Property="Stroke" Value="#FF6B72" />
        </Style>
        <Style Selector="Border.near.on TextBlock">
            <Setter Property="Foreground" Value="#FFD2D5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Border.fseg">
            <Setter Property="BorderBrush" Value="#1AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Height" Value="28" />
        </Style>
        <Style Selector="ToggleButton.ftog">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ftog StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Spacing" Value="6" />
        </Style>
        <Style Selector="ToggleButton.ftog Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ftog TextBlock">
            <Setter Property="FontFamily" Value="avares://Radar.Core/Assets/Fonts#Jura" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="LetterSpacing" Value="0.8" />
            <Setter Property="Foreground" Value="#B4BECB" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="ToggleButton.ftog /template/ ContentPresenter">
            <Setter Property="Transitions">
                <Transitions><BrushTransition Property="Background" Duration="0:0:0.12" /></Transitions>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.ftog:checked /template/ ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton.ftog:pointerover /template/ ContentPresenter, ToggleButton.ftog:checked:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ftog:pressed">
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton.ftog:pressed /template/ ContentPresenter, ToggleButton.ftog:checked:pressed /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A7CD4FF" />
        </Style>
        <Style Selector="ToggleButton.ftog:unchecked StackPanel">
            <Setter Property="Opacity" Value="0.38" />
        </Style>
        <Style Selector="ToggleButton.ftog:unchecked TextBlock">
            <Setter Property="TextDecorations" Value="Strikethrough" />
        </Style>
        <!-- ===== Сенсорный экран (телефон, планшет): цели касания не меньше ~40 dp, подписи крупнее ===== -->
        <Style Selector="v|MainView.touch Button.win">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
        </Style>
        <Style Selector="v|MainView.touch Button.win Path">
            <Setter Property="RenderTransform" Value="scale(1.3)" />
        </Style>
        <Style Selector="v|MainView.touch Button.mode">
            <Setter Property="Height" Value="44" />
            <Setter Property="Padding" Value="10,0,12,0" />
        </Style>
        <Style Selector="v|MainView.touch TabControl.side TabItem">
            <Setter Property="MinHeight" Value="44" />
        </Style>
        <Style Selector="v|MainView.touch ToggleButton.chsw">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="32" />
        </Style>
        <Style Selector="v|MainView.touch ToggleButton.chsw /template/ Border#track">
            <Setter Property="Height" Value="16" />
        </Style>
        <Style Selector="v|MainView.touch ToggleButton.chsw /template/ Border#knob">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="10" />
        </Style>
        <Style Selector="v|MainView.touch ToggleButton.chsw:checked /template/ Border#knob">
            <Setter Property="Margin" Value="29,0,2,0" />
        </Style>
        <Style Selector="v|MainView.touch Button.sbtn">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="v|MainView.touch Button.sbtn.donate">
            <Setter Property="Height" Value="48" />
        </Style>
        <Style Selector="v|MainView.touch TextBox.search">
            <Setter Property="Height" Value="40" />
            <Setter Property="FontSize" Value="14" />
        </Style>
        <Style Selector="v|MainView.touch ComboBox, v|MainView.touch CalendarDatePicker.range">
            <Setter Property="Height" Value="40" />
            <Setter Property="MinHeight" Value="40" />
        </Style>
        <Style Selector="v|MainView.touch Button.month, v|MainView.touch ToggleButton.rpick">
            <Setter Property="Height" Value="40" />
        </Style>
        <Style Selector="v|MainView.touch Button.modeitem">
            <Setter Property="MinHeight" Value="48" />
        </Style>
        <!-- телефон: подписи карточек сводки переносятся, а не обрезаются -->
        <Style Selector="v|MainView.compact TextBlock.kpisub">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxLines" Value="3" />
        </Style>
        <!-- телефон: пункты шапки компактнее, вкладки ленты помещаются по ширине -->
        <Style Selector="v|MainView.compact TextBlock.tabh">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="LetterSpacing" Value="0.4" />
        </Style>
    </UserControl.Styles>

    <Grid x:Name="Root" ColumnDefinitions="*,412">
        <!-- ===== Карта — на всё окно, под стеклянными панелями ===== -->
        <map:MapControl x:Name="Map" Grid.ColumnSpan="2" />

        <!-- ===== Собственная рамка окна: компактная полоса-телеметрия ===== -->
        <v:GlassPanel Grid.ColumnSpan="2" VerticalAlignment="Top" Height="28" Chamfer="0" Brackets="False" ShowBorder="False" Tint="#E6050608"
                      x:Name="TitleBar" PointerPressed="TitleBarPressed" DoubleTapped="TitleBarDoubleTapped">
            <Grid x:Name="TitleBarGrid" ColumnDefinitions="Auto,Auto,Auto,*,Auto,Auto,Auto">
                <!-- марка: индекс системы -->
                <StackPanel x:Name="Brand" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Canvas Width="12" Height="12" VerticalAlignment="Center">
                        <Path Stroke="#7CD4FF" StrokeThickness="1" Data="M0.5 3.5 V0.5 H3.5 M8.5 0.5 H11.5 V3.5 M11.5 8.5 V11.5 H8.5 M3.5 11.5 H0.5 V8.5" />
                        <Rectangle Canvas.Left="4.5" Canvas.Top="4.5" Width="3" Height="3" Fill="#7CD4FF" />
                    </Canvas>
                    <TextBlock x:Name="BrandText" Text="РАДАР" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="14" FontWeight="Bold" LetterSpacing="3" Foreground="#EEF3F8" VerticalAlignment="Center" />
                </StackPanel>
                <!-- режим: кнопка, раскрывающая меню режимов работы -->
                <Button Grid.Column="1" x:Name="ModePanel" Classes="mode" Classes.open="{Binding ModeMenuOpen}" Margin="8,0,0,0" Click="ModeButtonClick"
                        ToolTip.Tip="Режим работы: реальное время, история, статистика">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Panel Width="6" Height="6" VerticalAlignment="Center">
                            <Ellipse x:Name="LiveDot" Classes="live" Classes.offline="{Binding IsOffline}" Classes.connecting="{Binding IsConnecting}" IsVisible="{Binding IsLive}" />
                            <Ellipse Fill="{Binding ModeTagColor}" IsVisible="{Binding !IsLive}" />
                        </Panel>
                        <Panel>
                            <TextBlock Classes="live" Classes.offline="{Binding IsOffline}" Classes.connecting="{Binding IsConnecting}" IsVisible="{Binding IsLive}"
                                       Text="{Binding ModeTag}" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                            <TextBlock Foreground="{Binding ModeTagColor}" IsVisible="{Binding !IsLive}"
                                       Text="{Binding ModeTag}" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="11" FontWeight="Bold" LetterSpacing="1.2" VerticalAlignment="Center" />
                        </Panel>
                        <Path Classes="chev" Width="7" Height="4" Stretch="Uniform" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                              Data="M0 0 L3.5 3.5 L7 0" VerticalAlignment="Center" Margin="2,1,0,0" />
                    </StackPanel>
                </Button>
                <!-- телеметрия -->
                <StackPanel Grid.Column="4" x:Name="Telemetry" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="telcap" Text="ТРЕВОГИ" VerticalAlignment="Center" />
                        <TextBlock Classes="tel" Text="{Binding ActiveCount}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TelemetryKinds}" Classes="telks wide" Classes.any="{Binding HasTelemetryKinds}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TelemetryItem">
                                <Button Classes="telb" Classes.on="{Binding Visible}" Classes.off="{Binding Hidden}" Click="TelemetryKindClick" ToolTip.Tip="{Binding Tip}">
                                <StackPanel Classes="telk" Classes.on="{Binding Visible}" Classes.bump="{Binding Bump}">
                                    <Panel Classes="telkicon">
                                        <Ellipse Fill="{Binding Color}" />
                                        <Path Fill="{Binding Color}" Data="{Binding Icon}" />
                                    </Panel>
                                    <TextBlock Classes="tel" Text="{Binding Count}" />
                                </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="16,0,0,0">
                        <TextBlock Classes="telcap" Text="РЕГИОНЫ" VerticalAlignment="Center" />
                        <TextBlock Classes="tel" Text="{Binding RegionCount}" />
                    </StackPanel>
                </StackPanel>
                <!-- телеметрия для узкого окна: маркер и число, полная подпись — во всплывающей подсказке -->
                <StackPanel Grid.Column="4" x:Name="TelemetryCompact" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0" IsVisible="False">
                    <StackPanel Classes="telc" ToolTip.Tip="Активные тревоги">
                        <Path Width="9" Height="8" Stroke="#B4BECB" StrokeThickness="1" Data="M4.5 0.5 L8.5 7.5 H0.5 Z" />
                        <TextBlock Classes="tel" Text="{Binding ActiveCount}" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TelemetryKinds}" Classes="telks" Classes.any="{Binding HasTelemetryKinds}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:TelemetryItem">
                                <Button Classes="telb" Classes.on="{Binding Visible}" Classes.off="{Binding Hidden}" Click="TelemetryKindClick" ToolTip.Tip="{Binding Tip}">
                                <StackPanel Classes="telk" Classes.on="{Binding Visible}" Classes.bump="{Binding Bump}">
                                    <Panel Classes="telkicon">
                                        <Ellipse Fill="{Binding Color}" />
                                        <Path Fill="{Binding Color}" Data="{Binding Icon}" />
                                    </Panel>
                                    <TextBlock Classes="tel" Text="{Binding Count}" />
                                </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Classes="telc" ToolTip.Tip="Регионы с тревогой" Margin="12,0,0,0">
                        <Path Width="8" Height="8" Stroke="#B4BECB" StrokeThickness="1" Data="M0.5 0.5 H7.5 V7.5 H0.5 Z" />
                        <TextBlock Classes="tel" Text="{Binding RegionCount}" />
                    </StackPanel>
                </StackPanel>
                <!-- управление картой и боковой панелью -->
                <StackPanel Grid.Column="5" x:Name="MapButtons" Orientation="Horizontal">
                    <Rectangle Classes="sep" x:Name="MapSepLeft" Margin="0,0,4,0" />
                    <Button Classes="win" x:Name="ZoomInButton" Click="ZoomIn" ToolTip.Tip="Приблизить" IsEnabled="{Binding !IsOffline}">
                        <Path StrokeThickness="1" Data="M4.5 0 V9 M0 4.5 H9" Width="9" Height="9" />
                    </Button>
                    <Button Classes="win" x:Name="ZoomOutButton" Click="ZoomOut" ToolTip.Tip="Отдалить" IsEnabled="{Binding !IsOffline}">
                        <Path StrokeThickness="1" Data="M0 0.5 H9" Width="9" Height="1" />
                    </Button>
                    <Button Classes="win" Click="Home" ToolTip.Tip="Приграничные регионы (Home)" IsEnabled="{Binding !IsOffline}">
                        <Path StrokeThickness="1" Data="M5.5 0.5 A5 5 0 1 1 5.49 0.5 Z M5.5 3.5 A2 2 0 1 0 5.51 3.5 Z" Width="11" Height="11" />
                    </Button>
                    <Button Classes="win" x:Name="SidebarToggle" Click="ToggleSidebar" ToolTip.Tip="Скрыть боковую панель">
                        <Path StrokeThickness="1" Data="M0.5 0.5 H11.5 V9.5 H0.5 Z M7.5 0.5 V9.5 M8.5 3 H10.5 M8.5 5 H10.5 M8.5 7 H10.5" Width="12" Height="10" />
                    </Button>
                    <Rectangle Classes="sep" x:Name="MapSepRight" Margin="4,0" />
                </StackPanel>
                <!-- управление окном -->
                <StackPanel Grid.Column="6" x:Name="WinButtons" Orientation="Horizontal">
                    <Button Classes="win" Click="WinMinimize" ToolTip.Tip="Свернуть">
                        <!-- черта по нижнему краю квадрата «развернуть» -->
                        <Path StrokeThickness="1" Data="M0 0 M0 8.5 H9" Width="9" Height="9" />
                    </Button>
                    <Button Classes="win" x:Name="MaximizeButton" Click="WinMaximize" ToolTip.Tip="Развернуть">
                        <Path x:Name="MaximizeIcon" StrokeThickness="1" Data="M0.5 0.5 H8.5 V8.5 H0.5 Z" Width="9" Height="9" />
                    </Button>
                    <Button Classes="win close" Click="WinClose" ToolTip.Tip="Закрыть">
                        <Path StrokeThickness="1" Data="M0 0 L9 9 M9 0 L0 9" Width="9" Height="9" />
                    </Button>
                </StackPanel>
            </Grid>
        </v:GlassPanel>
        <!-- кромка под заголовком — индикатор обмена данными (импульсы запросов, волна при загрузке) -->
        <v:LoadingLine Grid.ColumnSpan="2" x:Name="LoadLine" VerticalAlignment="Top" Height="1" Margin="0,28,0,0"
                       IsBusy="{Binding IsBusy}" IsOffline="{Binding IsOffline}" />

        <Grid Grid.Column="0" Grid.ColumnSpan="2" x:Name="Overlays" Margin="0,0,412,0">

            <StackPanel x:Name="TopStack" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,40,0,0" Spacing="8">
            <!-- Режим выбора регионов для уведомлений -->
            <v:GlassPanel x:Name="PickBanner" Classes="panel" IsVisible="{Binding PickingOnMap}" Chamfer="8" Padding="14,8,8,8" HorizontalAlignment="Center">
                <Grid x:Name="PickGrid" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                    <Path Width="13" Height="15" Stretch="Uniform" Stroke="#7CD4FF" StrokeThickness="1.3" VerticalAlignment="Center"
                          Data="M6 0.5 C3 0.5 1 2.7 1 5.3 C1 8.6 6 13.5 6 13.5 C6 13.5 11 8.6 11 5.3 C11 2.7 9 0.5 6 0.5 Z M6 3.4 A1.9 1.9 0 1 1 5.99 3.4 Z" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="ВЫБОР ЗОН НАБЛЮДЕНИЯ" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="11.5" FontWeight="Bold" LetterSpacing="0.9" Foreground="#DDE6EF" />
                        <TextBlock FontSize="11" Foreground="#8C97A7" IsVisible="{Binding !PickPointMode}" TextWrapping="Wrap">
                            <Run Text="Регионы — на обзоре, районы — при приближении, пункты — по подписи, радиус — краем круга · выбрано: " /><Run Text="{Binding NotifyRegionsText}" Foreground="#9FD8F5" />
                        </TextBlock>
                        <TextBlock FontSize="11" Foreground="#8C97A7" IsVisible="{Binding PickPointMode}" TextWrapping="Wrap">
                            <Run Text="Своя точка в любом месте (дача, участок): клик — поставить или убрать, радиус — краем круга · выбрано: " /><Run Text="{Binding NotifyRegionsText}" Foreground="#9FD8F5" />
                        </TextBlock>
                    </StackPanel>
                    <Border Grid.Column="2" x:Name="PickModeSeg" Classes="fseg" Width="196" VerticalAlignment="Center">
                        <UniformGrid Rows="1">
                            <RadioButton Classes="seg" GroupName="pickmode" Content="ОБЛАСТЬ / ПУНКТ" IsChecked="{Binding !PickPointMode, Mode=OneWay}" Cursor="Hand" />
                            <RadioButton Classes="seg" GroupName="pickmode" Content="ТОЧКА" IsChecked="{Binding PickPointMode}" Cursor="Hand" />
                        </UniformGrid>
                    </Border>
                    <Button Grid.Column="3" x:Name="PickDone" Classes="sbtn" Click="FinishPickingClick" VerticalAlignment="Center">
                        <TextBlock Text="ГОТОВО" />
                    </Button>
                </Grid>
            </v:GlassPanel>
            <!-- Нет связи: данные на карте устарели -->
            <v:GlassPanel Classes="offline" Classes.on="{Binding IsOffline}" Shadow="{StaticResource PanelShadow}" Chamfer="8" Tint="#E01A0B0D" Accent="#E5484D" Padding="14,10,10,10" HorizontalAlignment="Center">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Width="22" Height="22" Stretch="Uniform" Stroke="#FF6B72" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center" Margin="0,0,12,0"
                          Data="M3 10 C10 3.5 18 3.5 25 10 M7 14.5 C11.5 10.5 16.5 10.5 21 14.5 M11 19 C12.8 17.5 15.2 17.5 17 19 M14 23.5 L14 23.6 M4 4 L24 24" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                        <TextBlock Text="Нет связи с каналами — обстановка устарела" FontFamily="{StaticResource HeadFont}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FF8A93" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StaleText}" FontSize="11.5" Foreground="#C9B3B5" TextWrapping="Wrap" LineHeight="16" />
                    </StackPanel>
                    <Button Grid.Column="2" Classes="emptyaction" Margin="14,0,0,0" VerticalAlignment="Center" Content="Повторить" Click="Refresh" />
                </Grid>
            </v:GlassPanel>
            </StackPanel>
            <!-- Напоминание о скрытых через легенду типах -->
            <Button x:Name="HiddenChip" Classes="leg glass" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" Padding="0" ClipToBounds="False"
                    IsVisible="{Binding HasHiddenKinds}" Click="LegendShowAll" ToolTip.Tip="{Binding HiddenKindsTip}">
                <Button.Transitions><Transitions><ThicknessTransition Property="Margin" Duration="0:0:0.6" Easing="CubicEaseOut" /></Transitions></Button.Transitions>
                <v:GlassPanel Chamfer="6" Shadow="{StaticResource PanelShadow}" Tint="#B01A140A" Accent="#D9A441" Padding="10,5,12,5">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Path Width="12" Height="12" Stretch="Uniform" Fill="#D9A441" VerticalAlignment="Center"
                              Data="M3 4h18l-7 8.5V19l-4 2v-8.5z" />
                        <TextBlock Text="{Binding HiddenKindsText}" FontSize="11" Foreground="#D9A441" VerticalAlignment="Center" />
                        <TextBlock Text="· показать" FontSize="11" Foreground="#8C7A52" VerticalAlignment="Center" />
                    </StackPanel>
                </v:GlassPanel>
            </Button>

            <!-- Первичная загрузка истории -->
            <v:GlassPanel x:Name="HistoryPanel" Classes="panel" IsVisible="{Binding HistoryLoading}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Width="300" Padding="14,10,14,11">
                <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">
                    <Ellipse Width="6" Height="6" Fill="#7CD4FF" VerticalAlignment="Center" Margin="0,0,9,0">
                        <Ellipse.Styles>
                            <Style Selector="Ellipse">
                                <Style.Animations>
                                    <Animation Duration="0:0:1.2" IterationCount="Infinite" PlaybackDirection="Alternate">
                                        <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
                                        <KeyFrame Cue="100%"><Setter Property="Opacity" Value="0.2" /></KeyFrame>
                                    </Animation>
                                </Style.Animations>
                            </Style>
                        </Ellipse.Styles>
                    </Ellipse>
                    <TextBlock Grid.Column="1" Classes="lhead" Text="{Binding HistoryTitle}" FontSize="12" />
                    <TextBlock Grid.Column="2" Classes="pnum" Text="{Binding HistoryPercent}" Foreground="#7CD4FF" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Classes="psub" Text="{Binding HistoryDetail}" Margin="0,3,0,0" />
                    <ProgressBar Grid.Row="2" Grid.ColumnSpan="3" Classes="pbar" Value="{Binding HistoryProgress}" Foreground="#7CD4FF" Margin="0,9,0,0">
                        <ProgressBar.Transitions>
                            <Transitions><DoubleTransition Property="Value" Duration="0:0:0.4" /></Transitions>
                        </ProgressBar.Transitions>
                    </ProgressBar>
                </Grid>
            </v:GlassPanel>

            <!-- Панель воспроизведения архива (режим «История»): месяц, время, лента с перемоткой, управление -->
            <v:GlassPanel x:Name="ReplayPanel" Classes="panel" IsVisible="{Binding IsHistory}" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,40" Width="460" Padding="14,10,14,8">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <!-- шапка: режим, выбор месяца, диапазон -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                        <Ellipse Width="6" Height="6" Fill="#F2C14E" VerticalAlignment="Center" Margin="0,0,9,0" />
                        <TextBlock Grid.Column="1" Classes="lhead" Text="ИСТОРИЯ" FontSize="12" Foreground="#F2C14E" VerticalAlignment="Center" />
                        <Button Grid.Column="3" Classes="month" Classes.open="{Binding MonthPickerOpen}" Click="MonthButtonClick" IsEnabled="{Binding HasArchiveMonths}"
                                ToolTip.Tip="Выбрать месяц архива">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="11" Height="11" Stretch="Uniform" Stroke="#8C97A7" StrokeThickness="1.1" VerticalAlignment="Center"
                                      Data="M0.5 2.5 H11.5 V11.5 H0.5 Z M0.5 5 H11.5 M3.5 0.5 V3.5 M8.5 0.5 V3.5" />
                                <TextBlock Text="{Binding HistoryMonthTitle}" FontSize="11.5" Foreground="#DDE6EF" VerticalAlignment="Center" />
                                <Path Classes="chev" Width="7" Height="4" Stretch="Uniform" StrokeThickness="1.2" StrokeLineCap="Round" StrokeJoin="Round"
                                      Data="M0 3.5 L3.5 0 L7 3.5" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </Grid>
                    <!-- время и управление -->
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,8,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding ReplayClock}" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="24" FontWeight="SemiBold" Foreground="#E8ECF1" FontFeatures="tnum" LineHeight="26" />
                            <TextBlock Classes="psub" Text="{Binding ReplayDate}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0">
                            <TextBlock Classes="pnum" Text="{Binding ReplaySpeedText}" Foreground="#F2C14E" HorizontalAlignment="Right" FontSize="13" />
                            <TextBlock Classes="psub" Text="{Binding ReplaySpeedHint}" HorizontalAlignment="Right" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
                            <Button Classes="pbtn" Click="ReplayRestart" ToolTip.Tip="С начала периода">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="M0 0 H2 V11 H0 Z M11 0 V11 L3 5.5 Z" />
                            </Button>
                            <Button Classes="pbtn" Click="ReplayBack" ToolTip.Tip="На час назад">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="M5.5 0 V11 L0 5.5 Z M11 0 V11 L5.5 5.5 Z" />
                            </Button>
                            <Button Classes="pbtn" Click="ReplaySlower" ToolTip.Tip="Медленнее">
                                <Path Width="11" Height="3" Stretch="Uniform" Data="M0 0 H11 V2 H0 Z" />
                            </Button>
                            <ToggleButton Classes="pbtn" IsChecked="{Binding ReplayPaused}" ToolTip.Tip="Пауза / продолжить">
                                <Panel>
                                    <Path Width="9" Height="10" Stretch="Uniform" Data="M0 0 H3.5 V11 H0 Z M6.5 0 H10 V11 H6.5 Z" IsVisible="{Binding !ReplayPaused}" />
                                    <Path Width="9" Height="10" Stretch="Uniform" Data="M0 0 L10 5.5 L0 11 Z" IsVisible="{Binding ReplayPaused}" />
                                </Panel>
                            </ToggleButton>
                            <Button Classes="pbtn" Click="ReplayFaster" ToolTip.Tip="Быстрее">
                                <Path Width="11" Height="11" Stretch="Uniform" Data="M4.5 0 H6.5 V4.5 H11 V6.5 H6.5 V11 H4.5 V6.5 H0 V4.5 H4.5 Z" />
                            </Button>
                            <Button Classes="pbtn" Click="ReplayForward" ToolTip.Tip="На час вперёд">
                                <Path Width="10" Height="10" Stretch="Uniform" Data="M0 0 L5.5 5.5 L0 11 Z M5.5 0 L11 5.5 L5.5 11 Z" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <!-- лента времени: активность каналов по часам, перемотка перетаскиванием и кликом -->
                    <Panel Grid.Row="2" Margin="-6,8,-6,0">
                        <v:Timeline x:Name="ReplayTimeline" Position="{Binding ReplayProgress}" Histogram="{Binding ReplayHistogram}"
                                    Start="{Binding ReplayStartTime}" End="{Binding ReplayEndTime}" />
                        <TextBlock Classes="psub" Text="восстановление обстановки…" IsVisible="{Binding HistoryBusy}" HorizontalAlignment="Center" VerticalAlignment="Top" Foreground="#F2C14E" />
                    </Panel>
                </Grid>
            </v:GlassPanel>

            <!-- выбор месяца архива: раскрывается над панелью истории -->
            <v:GlassPanel x:Name="MonthPicker" Classes="monthpick" Classes.open="{Binding MonthPickerOpen}" IsVisible="{Binding IsHistory}" Chamfer="8" Tint="#EE07090D"
                          Shadow="{StaticResource PanelShadow}" Padding="0,6" Width="220" VerticalAlignment="Bottom" HorizontalAlignment="Center">
                <ScrollViewer MaxHeight="300" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding HistoryMonths}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:MonthOption">
                                <Button Classes="modeitem" Classes.cur="{Binding Current}" Click="MonthItemClick" Padding="14,6">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#DDE6EF" />
                                        <Ellipse Grid.Column="1" Width="5" Height="5" Fill="#F2C14E" IsVisible="{Binding Current}" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </v:GlassPanel>

            <!-- Легенда -->
            <!-- Свёрнутая легенда: компактная кнопка -->
            <Button x:Name="LegendButton" Classes="leg glass" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,12" Padding="0"
                    IsVisible="{Binding LegendCollapsed}" Click="LegendToggleCollapsed" ToolTip.Tip="Показать условные знаки">
                <v:GlassPanel Classes="panel" Padding="12,8,14,8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Width="11" Height="11" Stretch="Uniform" Stroke="#8C97A7" StrokeThickness="1.6" StrokeLineCap="Round" VerticalAlignment="Center"
                              Data="M1 2 H3 M6 2 H15 M1 8 H3 M6 8 H15 M1 14 H3 M6 14 H15" />
                        <TextBlock Classes="label" Text="ОБОЗНАЧЕНИЯ" VerticalAlignment="Center" />
                        <Ellipse Width="6" Height="6" Fill="#D9A441" VerticalAlignment="Center" IsVisible="{Binding HasHiddenKinds}"
                                 ToolTip.Tip="Часть типов скрыта на карте" />
                        <Path Width="8" Height="5" Stretch="Uniform" Stroke="#5E6876" StrokeThickness="1.5" StrokeLineCap="Round" StrokeJoin="Round" VerticalAlignment="Center"
                              Data="M0 5 L4 1 L8 5" />
                    </StackPanel>
                </v:GlassPanel>
            </Button>

            <v:GlassPanel x:Name="LegendPanel" Classes="panel" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12,0,0,12" MaxHeight="640" Width="340"
                          IsVisible="{Binding LegendOpen}" Padding="14,11,14,12">
                <Grid RowDefinitions="Auto,*">
                    <!-- Шапка: название и действия -->
                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="4" Margin="0,0,-4,4">
                        <TextBlock Classes="lhead" Text="ОБОЗНАЧЕНИЯ" />
                        <Button Grid.Column="1" Classes="leg" Height="24" Padding="8,0" VerticalContentAlignment="Center" Click="LegendShowAll" IsVisible="{Binding HasHiddenKinds}"
                                ToolTip.Tip="Вернуть на карту все скрытые типы и уровни">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <Ellipse Width="5" Height="5" Fill="#D9A441" VerticalAlignment="Center" />
                                <TextBlock Text="показать все" FontSize="11" Foreground="#D9A441" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <ToggleButton Grid.Column="2" Classes="ltog" IsChecked="{Binding LegendExpanded}"
                                      ToolTip.Tip="Показать каждый тип угрозы отдельной строкой с названием">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Width="10" Height="9" Stretch="Uniform" StrokeThickness="1.4" StrokeLineCap="Round" VerticalAlignment="Center"
                                      Data="M0 1 H1.5 M4 1 H12 M0 5 H1.5 M4 5 H12 M0 9 H1.5 M4 9 H12" />
                                <TextBlock Text="ВСЕ ТИПЫ" VerticalAlignment="Center" />
                            </StackPanel>
                        </ToggleButton>
                        <Button Grid.Column="3" Classes="lbtn" Click="LegendToggleCollapsed" ToolTip.Tip="Свернуть условные знаки">
                            <Path Width="9" Height="5" Stretch="Uniform" StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" Data="M0 0.5 L4.5 5 L9 0.5" />
                        </Button>
                    </Grid>

                    <!-- полоса прокрутки — посередине правого отступа панели -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" Margin="0,0,-14,0">
                        <StackPanel Margin="0,0,14,0">
                            <!-- ТИПЫ УГРОЗ -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ТИПЫ УГРОЗ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <!-- компактно: группа — ряд иконок одинаковыми ячейками — счётчик -->
                            <ItemsControl ItemsSource="{Binding Legend}" IsVisible="{Binding !LegendExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendGroup">
                                        <Grid ColumnDefinitions="96,*,30" ColumnSpacing="8" Classes="lrow">
                                            <Button Classes="leg" Padding="4,2" Click="LegendGroupClick" ToolTip.Tip="{Binding GroupTip}" VerticalAlignment="Center"
                                                    HorizontalContentAlignment="Right">
                                                <TextBlock Classes="lt" Text="{Binding ShortTitle}" Foreground="#8C97A7" TextAlignment="Right" />
                                            </Button>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Items}" VerticalAlignment="Center">
                                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemWidth="17" ItemHeight="20" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LegendItem">
                                                        <Button Classes="leg" Padding="0" Click="LegendItemClick" ToolTip.Tip="{Binding Tip}" Opacity="{Binding ItemOpacity}"
                                                                HorizontalContentAlignment="Center" VerticalContentAlignment="Center" VerticalAlignment="Stretch">
                                                            <Viewbox Width="14" Height="14">
                                                                <Canvas Width="24" Height="24"><Path Fill="{Binding Color}" Data="{Binding Icon}" /></Canvas>
                                                            </Viewbox>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <Border Grid.Column="2" Classes="cnt" Classes.bump="{Binding Bump}" IsVisible="{Binding HasCount}" HorizontalAlignment="Right">
                                                <TextBlock Classes="cn" Text="{Binding Count}" Foreground="{Binding CountColor}" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <!-- подробно: каждый тип строкой -->
                            <ItemsControl ItemsSource="{Binding Legend}" IsVisible="{Binding LegendExpanded}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LegendGroup">
                                        <StackPanel Margin="0,0,0,6">
                                            <Button Classes="leg" Padding="4,2" Click="LegendGroupClick" ToolTip.Tip="{Binding GroupTip}">
                                                <Grid ColumnDefinitions="*,30" Classes="lrow">
                                                    <TextBlock Classes="lt" Text="{Binding Title}" FontWeight="SemiBold" Foreground="#6A7686" />
                                                    <Border Grid.Column="1" Classes="cnt" Classes.bump="{Binding Bump}" IsVisible="{Binding HasCount}" HorizontalAlignment="Right">
                                                        <TextBlock Classes="cn" Text="{Binding Count}" Foreground="{Binding CountColor}" />
                                                    </Border>
                                                </Grid>
                                            </Button>
                                            <ItemsControl ItemsSource="{Binding Items}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:LegendItem">
                                                        <Button Classes="leg" Padding="4,2" Click="LegendItemClick" ToolTip.Tip="{Binding Tip}" Opacity="{Binding ItemOpacity}">
                                                            <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8" Classes="lrow">
                                                                <Viewbox Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                                    <Canvas Width="24" Height="24"><Path Fill="{Binding Color}" Data="{Binding Icon}" /></Canvas>
                                                                </Viewbox>
                                                                <TextBlock Grid.Column="1" Classes="lt" Text="{Binding Name}" Foreground="{Binding TextColor}" />
                                                                <Border Grid.Column="2" Classes="cnt" Classes.bump="{Binding Bump}" IsVisible="{Binding HasCount}" HorizontalAlignment="Right">
                                                                    <TextBlock Classes="cn" Text="{Binding Count}" Foreground="{Binding Color}" />
                                                                </Border>
                                                            </Grid>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- УРОВЕНЬ: плитки одинаковой ширины 2×2 -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="УРОВЕНЬ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Levels}" Margin="4,1,0,0">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:LevelItem">
                                        <Button Classes="leg" Padding="0" Margin="0,0,4,4" Click="LevelClick" ToolTip.Tip="{Binding Tip}" Opacity="{Binding ItemOpacity}"
                                                HorizontalContentAlignment="Stretch">
                                            <Border Classes="lvl" Classes.bump="{Binding Bump}" Background="{Binding Bg}" CornerRadius="0" Padding="8,3,8,4">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding Fg}" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Count}" IsVisible="{Binding HasCount}" FontSize="11" FontWeight="Bold"
                                                               Foreground="{Binding Fg}" Opacity="0.8" FontFeatures="tnum" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ЗОНЫ -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ЗОНЫ НА КАРТЕ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Border Classes="lrow" ToolTip.Tip="Регион или район, где объявлена тревога или замечена угроза">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Border Width="13" Height="9" Background="#22F28C38" BorderBrush="#F28C38" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Регион / район под угрозой" />
                                </Grid>
                            </Border>
                            <Button Classes="leg" Padding="4,2" Click="ExpectedClick" ToolTip.Tip="{Binding ExpectedTip}" Opacity="{Binding ExpectedOpacity}">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8" Classes="lrow">
                                    <Border Width="13" Height="9" BorderBrush="#F28C38" BorderThickness="1" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                <GradientStop Color="#55F28C38" Offset="0" />
                                                <GradientStop Color="#00F28C38" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Ожидается (по направлению угрозы)" />
                                    <Border Grid.Column="2" Classes="cnt" IsVisible="{Binding HasExpectedCount}" HorizontalAlignment="Right">
                                        <TextBlock Classes="cn" Text="{Binding ExpectedCount}" Foreground="#F2B072" />
                                    </Border>
                                </Grid>
                            </Button>
                            <Border Classes="lrow" ToolTip.Tip="Тревога в этом месте снята">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Ellipse Width="10" Height="10" Stroke="#4FB286" StrokeThickness="1.6" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Отбой" />
                                </Grid>
                            </Border>
                            <Button Classes="leg" Padding="4,2" Click="FrontLineClick" ToolTip.Tip="{Binding FrontLineTip}" Opacity="{Binding FrontLineOpacity}">
                                <Grid ColumnDefinitions="26,*,30" RowDefinitions="Auto,Auto" ColumnSpacing="8" Classes="lrow">
                                    <Line StartPoint="1,4.5" EndPoint="23,4.5" Width="24" Height="9" HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Stroke="#C8B4553F" StrokeThickness="1.6" StrokeDashArray="2.5,1.5" />
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Линия соприкосновения" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FrontLineSourceText}" FontSize="10.5" Foreground="{Binding FrontLineSourceColor}"
                                               FontFeatures="tnum" Margin="0,0,0,1" />
                                </Grid>
                            </Button>

                            <!-- ТРАЕКТОРИИ -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ТРАЕКТОРИИ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Border Classes="lrow" ToolTip.Tip="Сплошная линия — путь по подтверждённым сообщениям; ромбы — точки фиксации">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="9" VerticalAlignment="Center">
                                        <Line StartPoint="1,4.5" EndPoint="21,4.5" StrokeThickness="1.8" StrokeLineCap="Round">
                                            <Line.Stroke>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#6E8C97A7" Offset="0" />
                                                    <GradientStop Color="#FF8C97A7" Offset="1" />
                                                </LinearGradientBrush>
                                            </Line.Stroke>
                                        </Line>
                                        <Path Fill="#8C97A7" Data="M22 1.5 L25 4.5 L22 7.5 L19 4.5 Z" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Пройденный путь" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="Пунктир до названного в сообщении пункта; кольцо — цель, рядом время прибытия (если скорость измерена)">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="9" VerticalAlignment="Center">
                                        <Line StartPoint="1,4.5" EndPoint="17,4.5" Stroke="#8C8C97A7" StrokeThickness="1.5" StrokeDashArray="1.3,2" StrokeLineCap="Round" />
                                        <Ellipse Canvas.Left="17.5" Canvas.Top="0.5" Width="8" Height="8" Stroke="#968C97A7" StrokeThickness="1.3" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Прогноз к пункту" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="«В направлении области / района / моря»: известно только направление — короткий бледный пунктир со стрелкой, без времени прибытия">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="9" VerticalAlignment="Center">
                                        <Line StartPoint="1,4.5" EndPoint="23,4.5" StrokeThickness="1.3" StrokeDashArray="1,3" StrokeLineCap="Round">
                                            <Line.Stroke>
                                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                                    <GradientStop Color="#698C97A7" Offset="0" />
                                                    <GradientStop Color="#1A8C97A7" Offset="1" />
                                                </LinearGradientBrush>
                                            </Line.Stroke>
                                        </Line>
                                        <Path Stroke="#548C97A7" StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" Data="M20 1 L24.5 4.5 L20 8" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Направление на регион" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="Две отметки ведут к линии фронта без цели и курса в сообщениях — скорее неточная привязка (центр района), чем разворот: путь не рисуется, значок без направления, пунктир — где примерно находится объект">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="12" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="7" Canvas.Top="0" Width="12" Height="12" Fill="#128C97A7" Stroke="#828C97A7" StrokeThickness="1.1" StrokeDashArray="1.5,2" />
                                        <Ellipse Canvas.Left="11.5" Canvas.Top="4.5" Width="3" Height="3" Fill="#8C97A7" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Курс не определён" />
                                </Grid>
                            </Border>

                            <!-- ПУСКИ -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ПУСКИ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Border Classes="lrow" ToolTip.Tip="Пуск (запуск, выход) со стороны противника: место пуска и направление. Пунктир — «возможны пуски», регионы РФ не заливаются">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="#10141A" Stroke="#FF7A59" StrokeThickness="1.4" Data="M4.5 0 L9 4.5 L4.5 9 L0 4.5 Z"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Пуск / возможны пуски" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="Место пуска названо в сообщении («пуски из Сумской области», «с моря»): сплошное кольцо и пунктир предыстории до первой фиксации">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="9" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="0.5" Canvas.Top="0" Width="9" Height="9" Stroke="#C88C97A7" StrokeThickness="1.2" />
                                        <Ellipse Canvas.Left="3.3" Canvas.Top="2.8" Width="3.4" Height="3.4" Fill="#C88C97A7" />
                                        <Line StartPoint="12,4.5" EndPoint="25,4.5" Stroke="#788C97A7" StrokeThickness="1.2" StrokeDashArray="1.2,3.2" StrokeLineCap="Round" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Место пуска названо" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="Место пуска не названо: выведено по курсу (ближайший участок границы, линии соприкосновения или моря позади первой фиксации) — пунктирное кольцо, бледнее">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="26" Height="9" VerticalAlignment="Center">
                                        <Ellipse Canvas.Left="0.5" Canvas.Top="0" Width="9" Height="9" Stroke="#788C97A7" StrokeThickness="1.2" StrokeDashArray="1.6,1.6" />
                                        <Ellipse Canvas.Left="3.3" Canvas.Top="2.8" Width="3.4" Height="3.4" Fill="#788C97A7" />
                                        <Line StartPoint="12,4.5" EndPoint="25,4.5" Stroke="#508C97A7" StrokeThickness="1.2" StrokeDashArray="1.2,3.2" StrokeLineCap="Round" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Место пуска предполагаемое" />
                                </Grid>
                            </Border>

                            <!-- СКОПЛЕНИЯ -->
                            <Grid Classes="lsec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="СКОПЛЕНИЯ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Border Classes="lrow" ToolTip.Tip="Несколько объектов рядом объединены: число — сколько объектов, щелчок раскрывает группу веером">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="22" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Path Canvas.Left="1" Canvas.Top="3" Width="10" Height="10" Stretch="Uniform" Fill="#F28C38" Data="M5 0 L10 10 L5 7.5 L0 10 Z" />
                                        <Ellipse Canvas.Left="9" Canvas.Top="0" Width="11" Height="11" Fill="#10141A" Stroke="#F28C38" StrokeThickness="1.2" />
                                        <TextBlock Canvas.Left="12" Canvas.Top="-0.5" Text="3" FontSize="8.5" FontWeight="Bold" Foreground="#DDE3EA" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Группа объектов" />
                                </Grid>
                            </Border>
                            <Border Classes="lrow" ToolTip.Tip="Несколько тревог в одном месте: число — сколько тревог, цвет кольца — доли типов угроз; щелчок раскрывает веером">
                                <Grid ColumnDefinitions="26,*,30" ColumnSpacing="8">
                                    <Canvas Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <Ellipse Width="13" Height="13" Fill="#10141A" />
                                        <Path Stroke="#F28C38" StrokeThickness="2" Data="M6.5 0.5 A6 6 0 1 1 0.8 8.6" />
                                        <Path Stroke="#E5484D" StrokeThickness="2" Data="M0.8 8.6 A6 6 0 0 1 6.5 0.5" />
                                        <TextBlock Canvas.Left="3.6" Canvas.Top="0.6" Text="4" FontSize="8.5" FontWeight="Bold" Foreground="#DDE3EA" />
                                    </Canvas>
                                    <TextBlock Grid.Column="1" Classes="lt" Text="Несколько тревог в одном месте" />
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </v:GlassPanel>

        </Grid>

        <!-- затемнение под боковой панелью-шторкой (телефон, планшет в портрете): касание закрывает шторку -->
        <Border Grid.ColumnSpan="2" x:Name="SidebarScrim" Background="#99000000" IsVisible="False" Opacity="0" PointerPressed="ScrimPressed">
            <Border.Transitions><Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.3" /></Transitions></Border.Transitions>
        </Border>

        <!-- ===== Боковая панель: стекло над картой, выезжает справа ===== -->
        <v:GlassPanel Grid.Column="1" x:Name="Sidebar" Margin="0,40,12,12" Chamfer="10" Tint="#D8070A0E" Shadow="{StaticResource PanelShadow}" RenderTransform="translateX(0px)">
            <v:GlassPanel.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.38" Easing="CubicEaseOut" />
                    <DoubleTransition Property="Opacity" Duration="0:0:0.38" Easing="CubicEaseOut" />
                </Transitions>
            </v:GlassPanel.Transitions>
        <Grid RowDefinitions="Auto,*,Auto">
            <StackPanel Grid.Row="0" Margin="16,12,16,6" Spacing="10">
                <!-- шапка: название и число активных тревог (как у панели обозначений) -->
                <Grid ColumnDefinitions="*,Auto" Height="24">
                    <TextBlock Classes="lhead" Text="ОПЕРАТИВНАЯ ЛЕНТА" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Classes="tel" Text="{Binding ActiveCount}" />
                        <TextBlock Classes="lsec" Text="АКТИВНЫХ" Margin="0" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <TextBox Classes="search" PlaceholderText="Поиск по региону или городу" Text="{Binding FilterText}" />
                    <!-- только мои регионы (появляется, когда регионы выбраны в настройках) -->
                    <ToggleButton Grid.Column="1" Classes="rpick" IsChecked="{Binding OnlyMine}" IsVisible="{Binding HasPickedRegions}" Margin="6,0,0,0"
                                  ToolTip.Tip="Показывать в ленте только тревоги выбранных зон наблюдения (карта не фильтруется)">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Width="11" Height="11" Stretch="Uniform" Data="M6 0.5 C3 0.5 1 2.7 1 5.3 C1 8.6 6 13.5 6 13.5 C6 13.5 11 8.6 11 5.3 C11 2.7 9 0.5 6 0.5 Z M6 3.4 A1.9 1.9 0 1 1 5.99 3.4 Z" />
                            <TextBlock Text="МОИ" />
                        </StackPanel>
                    </ToggleButton>
                </Grid>
                <!-- фильтры ленты: одна строка-сегмент; выключенный — приглушён и перечёркнут -->
                <Border Classes="fseg">
                    <UniformGrid Rows="1">
                        <ToggleButton Classes="ftog" IsChecked="{Binding ShowUav}" ToolTip.Tip="Беспилотники">
                            <StackPanel><Ellipse Fill="#F28C38" /><TextBlock Text="БПЛА" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="ftog" IsChecked="{Binding ShowMissile}" ToolTip.Tip="Ракеты и авиация">
                            <StackPanel><Ellipse Fill="#E5484D" /><TextBlock Text="РАКЕТЫ" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="ftog" IsChecked="{Binding ShowOther}" ToolTip.Tip="Прочее: море, обстрелы, аэростаты, ДРГ">
                            <StackPanel><Ellipse Fill="#E2C044" /><TextBlock Text="ПРОЧЕЕ" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="ftog" IsChecked="{Binding ShowLaunch}" ToolTip.Tip="Сообщения о пусках: место пуска на стороне противника и направление">
                            <StackPanel><Ellipse Fill="#FF7A59" /><TextBlock Text="ПУСКИ" /></StackPanel>
                        </ToggleButton>
                        <ToggleButton Classes="ftog" IsChecked="{Binding ShowAllClear}" ToolTip.Tip="Отбой тревоги">
                            <StackPanel><Ellipse Fill="#4FB286" /><TextBlock Text="ОТБОЙ" /></StackPanel>
                        </ToggleButton>
                    </UniformGrid>
                </Border>
            </StackPanel>

            <Rectangle Grid.Row="1" Classes="tabline" />
            <TabControl Grid.Row="1" x:Name="SideTabs" Classes="side" Padding="0" Margin="16,0,0,0">
                <TabItem>
                    <TabItem.Header><TextBlock Classes="tabh" Text="ТРЕВОГИ" /></TabItem.Header>
                    <Panel>
                    <!-- пустая лента: своя причина, пояснение и действие -->
                    <StackPanel Classes="empty" IsVisible="{Binding IsEmpty}">
                        <Panel Classes="emptyicon">
                            <!-- нет тревог: щит с отметкой -->
                            <Path IsVisible="{Binding EmptyCalm}" Stroke="#4FB286" Data="M14 2 L25 6 V13 C25 20 20 24.5 14 26.5 C8 24.5 3 20 3 13 V6 Z M9 14 L12.5 17.5 L19 10.5" />
                            <!-- нет связи: перечёркнутый сигнал -->
                            <Path IsVisible="{Binding EmptyOffline}" Stroke="#8C97A7" Data="M3 10 C10 3.5 18 3.5 25 10 M7 14.5 C11.5 10.5 16.5 10.5 21 14.5 M11 19 C12.8 17.5 15.2 17.5 17 19 M14 23.5 L14 23.6 M4 4 L24 24" />
                            <!-- ничего не найдено: лупа -->
                            <Path IsVisible="{Binding EmptySearch}" Stroke="#8C97A7" Data="M12 3 A9 9 0 1 1 11.99 3 Z M18.5 18.5 L25 25 M8.5 12 H15.5" />
                            <!-- всё скрыто: воронка -->
                            <Path IsVisible="{Binding EmptyFiltered}" Stroke="#D9A441" Data="M3 4 H25 L16.5 14.5 V22 L11.5 25 V14.5 Z" />
                            <!-- загрузка: развёртка радара -->
                            <Panel IsVisible="{Binding EmptyLoading}">
                                <Path Stroke="#3A4452" Data="M14 2 A12 12 0 1 1 13.99 2 Z M14 8 A6 6 0 1 1 13.99 8 Z" />
                                <Path Classes="sweep" Stroke="#7CD4FF" Data="M14 14 L14 2" />
                            </Panel>
                        </Panel>
                        <TextBlock Classes="emptytitle" Text="{Binding EmptyTitle}" />
                        <TextBlock Classes="emptytext" Text="{Binding EmptyDetail}" />
                        <Button Classes="emptyaction" IsVisible="{Binding HasEmptyAction}" Content="{Binding EmptyAction}" Click="EmptyActionClick" />
                    </StackPanel>
                    <ListBox x:Name="EventsList" Classes="feed" IsVisible="{Binding !IsEmpty}" ItemsSource="{Binding Events}" SelectedItem="{Binding Selected}" Margin="-16,4,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="m:AlertEvent">
                                <Panel>
                                <Border Classes="flash" Classes.on="{Binding Flash}" Background="{Binding ColorHex}">
                                    <Border.OpacityMask>
                                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                                            <GradientStop Offset="0" Color="#FF000000" />
                                            <GradientStop Offset="1" Color="#00000000" />
                                        </LinearGradientBrush>
                                    </Border.OpacityMask>
                                </Border>
                                <Border Classes="card" Classes.mine="{Binding IsMine}">
                                    <Grid ColumnDefinitions="2,*" >
                                        <Rectangle Grid.Column="0" Fill="{Binding ColorHex}" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="5">
                                            <!-- строка прибора: иконка и тип угрозы — уровень — время -->
                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                    <Viewbox Width="13" Height="13" VerticalAlignment="Center">
                                                        <Canvas Width="24" Height="24"><Path Fill="{Binding ColorHex}" Data="{Binding IconPath}" /></Canvas>
                                                    </Viewbox>
                                                    <TextBlock Classes="cardkind" Text="{Binding ThreatCaps}" Foreground="{Binding ColorHex}" />
                                                </StackPanel>
                                                <!-- шкала уровня: 4 сегмента -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center" Margin="0,0,10,0" ToolTip.Tip="{Binding StatusText}">
                                                    <Rectangle Width="7" Height="3" Fill="{Binding ColorHex}" Opacity="{Binding Seg1}" />
                                                    <Rectangle Width="7" Height="3" Fill="{Binding ColorHex}" Opacity="{Binding Seg2}" />
                                                    <Rectangle Width="7" Height="3" Fill="{Binding ColorHex}" Opacity="{Binding Seg3}" />
                                                    <Rectangle Width="7" Height="3" Fill="{Binding ColorHex}" Opacity="{Binding Seg4}" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="3" Classes="tel" Text="{Binding TimeShort}" FontSize="12" Foreground="#8C97A7" ToolTip.Tip="{Binding Ago}" />
                                            </Grid>
                                            <TextBlock Text="{Binding RegionNames}" FontFamily="{StaticResource HeadFont}" FontSize="14" FontWeight="SemiBold" Foreground="#EEF3F8" TextWrapping="Wrap" LineHeight="18" />
                                            <TextBlock Text="{Binding KindsText}" IsVisible="{Binding HasKinds}" FontSize="11" Foreground="#6B7584" TextWrapping="Wrap" Margin="0,-2,0,0" />
                                            <Border IsVisible="{Binding HasPartialClear}" HorizontalAlignment="Left" Background="#13221C" BorderBrush="#3A7A5E" BorderThickness="1,0,0,0"
                                                    CornerRadius="0" Padding="7,2" ToolTip.Tip="{Binding PartialClearTip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Ellipse Width="8" Height="8" Stroke="#4FB286" StrokeThickness="1.6" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding PartialClearText}" FontSize="11" Foreground="#9FD8BC" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <Border IsVisible="{Binding HasMotion}" HorizontalAlignment="Left" Background="#0F7CD4FF" BorderBrush="#337CD4FF" BorderThickness="1,0,0,0" CornerRadius="0" Padding="8,3" ToolTip.Tip="{Binding MotionTip}">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Width="10" Height="10" Stretch="Uniform" Fill="{Binding ColorHex}" Data="M0 4 H7 V1 L11 5 L7 9 V6 H0 Z" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Motion}" FontSize="11" Foreground="#DDE3EA" />
                                                </StackPanel>
                                            </Border>
                                            <!-- относительно своего пункта / точки: расстояние, сторона, движение -->
                                            <Border Classes="near" Classes.on="{Binding NearApproaching}" IsVisible="{Binding HasNear}" HorizontalAlignment="Left" ToolTip.Tip="Расчётное положение относительно ближайшего выбранного пункта">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <Path Width="9" Height="11" Stretch="Uniform" VerticalAlignment="Center" Data="M6 0.5 C3 0.5 1 2.7 1 5.3 C1 8.6 6 13.5 6 13.5 C6 13.5 11 8.6 11 5.3 C11 2.7 9 0.5 6 0.5 Z M6 3.4 A1.9 1.9 0 1 1 5.99 3.4 Z" />
                                                    <TextBlock Text="{Binding NearText}" FontSize="11" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock Text="{Binding Summary}" IsVisible="{Binding HasSummary}" ToolTip.Tip="{Binding Text}" FontSize="11.5" Foreground="#8A96A6" TextWrapping="Wrap" MaxLines="4" TextTrimming="CharacterEllipsis" LineHeight="16" />
                                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,1,0,0">
                                                <Border Classes="lvlup" Classes.on="{Binding LevelUp}" Background="{Binding LevelBg}" Padding="6,2,6,2" VerticalAlignment="Center">
                                                    <TextBlock Classes="cardstatus" Text="{Binding StatusCaps}" Foreground="{Binding LevelFg}" />
                                                </Border>
                                                <Border Classes="minetag" IsVisible="{Binding IsMine}" ToolTip.Tip="Касается выбранных зон наблюдения">
                                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                                        <Path Width="8" Height="10" Stretch="Uniform" Data="M6 0.5 C3 0.5 1 2.7 1 5.3 C1 8.6 6 13.5 6 13.5 C6 13.5 11 8.6 11 5.3 C11 2.7 9 0.5 6 0.5 Z M6 3.4 A1.9 1.9 0 1 1 5.99 3.4 Z" />
                                                        <TextBlock Text="МОЯ ЗОНА" />
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Classes="cardsrc" Text="{Binding SourceCount}" ToolTip.Tip="{Binding SourceText}" />
                                            </StackPanel>
                                            <StackPanel IsVisible="{Binding ShowHistory}" Spacing="3" Margin="0,6,0,0">
                                                <TextBlock Classes="lsec" Text="{Binding HistoryHeader}" Margin="0,0,0,2" />
                                                <ItemsControl ItemsSource="{Binding HistoryView}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="m:EventHistoryEntry">
                                                            <Grid ColumnDefinitions="38,Auto,*" Margin="0,1">
                                                                <TextBlock Grid.Column="0" Classes="tel" Text="{Binding TimeText}" FontSize="11" Foreground="#5E6876" VerticalAlignment="Top" />
                                                                <TextBlock Grid.Column="1" Text="{Binding ChannelText}" FontSize="11" Foreground="#7F8A9A" Margin="0,0,8,0" />
                                                                <TextBlock Grid.Column="2" Text="{Binding Text}" FontSize="11" Foreground="#AEB7C4" TextWrapping="Wrap" />
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Panel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Panel>
                </TabItem>
                <TabItem>
                    <TabItem.Header><TextBlock Classes="tabh" Text="СООБЩЕНИЯ" /></TabItem.Header>
                    <Panel>
                    <StackPanel Classes="empty" IsVisible="{Binding FeedEmpty}">
                        <Panel Classes="emptyicon">
                            <Path Stroke="#8C97A7" Data="M3 5 H25 V19 H11 L5 24 V19 H3 Z M8 10 H20 M8 14 H16" />
                        </Panel>
                        <TextBlock Classes="emptytitle" Text="{Binding FeedEmptyTitle}" />
                        <TextBlock Classes="emptytext" Text="{Binding FeedEmptyDetail}" />
                    </StackPanel>
                    <ListBox Classes="feed" IsVisible="{Binding !FeedEmpty}" ItemsSource="{Binding Feed}" DoubleTapped="FeedDoubleTapped" Margin="-16,4,0,0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:FeedItem">
                                <Border Classes="msg" Opacity="{Binding Dim}">
                                    <Grid ColumnDefinitions="2,*">
                                        <Rectangle Fill="{Binding Color}" Opacity="0.7" />
                                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="5">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Classes="msgch" Text="{Binding Channel}" />
                                                <TextBlock Grid.Column="1" Classes="tel" Text="{Binding Time}" FontSize="12" Foreground="#8C97A7" />
                                            </Grid>
                                            <TextBlock Text="{Binding Text}" FontSize="12" Foreground="#B4BECB" TextWrapping="Wrap" LineHeight="17" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    </Panel>
                </TabItem>
                <TabItem>
                    <TabItem.Header><TextBlock Classes="tabh" Text="ИСТОЧНИКИ" /></TabItem.Header>
                    <ScrollViewer Margin="-16,4,0,0">
                        <StackPanel Spacing="0">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="16,10,16,6">
                                <TextBlock Classes="lsec" Text="TELEGRAM-КАНАЛЫ" />
                                <Border Grid.Column="1" Classes="lsec" />
                                <TextBlock Grid.Column="2" Classes="lsec" Margin="8,0,0,0" Text="{Binding ChannelsSummary}" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding Channels}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChannelRow">
                                        <Border Classes="chrow" ToolTip.Tip="{Binding Tip}" DoubleTapped="ChannelDoubleTapped" Opacity="{Binding Dim}">
                                            <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto" RowSpacing="3">
                                                <Ellipse Grid.RowSpan="2" Classes="chdot" Classes.pulse="{Binding Pulsing}" Fill="{Binding StateColor}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontFamily="{StaticResource HeadFont}" FontSize="13" FontWeight="SemiBold" Foreground="#DDE3EA" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Classes="chstate" Text="{Binding StateCaps}" Foreground="{Binding StateColor}" />
                                                    <ToggleButton Classes="chsw" IsChecked="{Binding Enabled, Mode=OneWay}" Click="ChannelToggleClick" ToolTip.Tip="{Binding ToggleTip}"
                                                                  IsEnabled="{Binding $parent[Window].((vm:MainViewModel)DataContext).IsLive}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" FontSize="10.5" Foreground="#6B7584" TextTrimming="CharacterEllipsis" Margin="0,0,40,0">
                                                    <Run Text="{Binding Handle}" Foreground="#8C97A7" />
                                                    <Run Text="  ·  " Foreground="#3A4452" />
                                                    <Run Text="{Binding Detail}" />
                                                </TextBlock>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel Spacing="12" Margin="16,14,16,12">
                                <TextBlock FontSize="11" Foreground="#6B7584" TextWrapping="Wrap" LineHeight="16"
                                           Text="«Тишина» — канал отвечает, но постов не было больше 12 часов. Переключатель справа включает и выключает опрос канала. Интервал опроса и время жизни тревог — во вкладке «Настройки», список каналов — в settings.json в папке данных приложения. Двойной щелчок по каналу или сообщению открывает его в Telegram." />
                                <Border BorderBrush="#D9A441" BorderThickness="1,0,0,0" Background="#15120D" CornerRadius="0" Padding="12,10">
                                    <TextBlock FontSize="11" Foreground="#C9A46A" TextWrapping="Wrap" LineHeight="16"
                                               Text="Данные собираются автоматически из открытых источников и могут быть неточными. Приоритет — у официальных сигналов оповещения МЧС и местных властей." />
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem>
                    <TabItem.Header><TextBlock Classes="tabh" Text="НАСТРОЙКИ" /></TabItem.Header>
                    <ScrollViewer Margin="-16,4,0,0" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="16,0,16,16">
                            <!-- ЭКРАН -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ЭКРАН" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Ретро-эффект" /><TextBlock Classes="shint" Text="Зерно, строки развёртки и лёгкие помехи аналогового монитора" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Ретро-эффект" IsChecked="{Binding RetroNoise}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Потеря сигнала" /><TextBlock Classes="shint" Text="При обрыве связи карта обесцвечивается и «шумит» — сразу видно, что обстановка устарела" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Потеря сигнала" IsChecked="{Binding SignalLossEffect}" />
                            </Grid>
                            <StackPanel Classes="sblock">
                                <TextBlock Classes="sname" Text="Плавность анимации" />
                                <TextBlock Classes="shint" Text="Пульсация отметок, бегущие пунктиры и помехи. Карта рисуется на процессоре: плавнее — выше нагрузка" Margin="0,2,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="animq" Content="ЭКОНОМНО" IsChecked="{Binding AnimationQuality, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=0}" />
                                        <RadioButton Classes="seg" GroupName="animq" Content="ОБЫЧНО" IsChecked="{Binding AnimationQuality, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=1}" />
                                        <RadioButton Classes="seg" GroupName="animq" Content="ПЛАВНО" IsChecked="{Binding AnimationQuality, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=2}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Затенение краёв" /><TextBlock Classes="shint" Text="Мягкая виньетка по краям карты" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Затенение краёв" IsChecked="{Binding Vignette}" />
                            </Grid>

                            <!-- ДАННЫЕ -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ДАННЫЕ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <StackPanel>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sname" Text="Доступ к Telegram" />
                                </Grid>
                                <TextBlock Classes="shint" Text="Где Telegram заблокирован, ленты каналов читаются через проверенные бесплатные прокси — без VPN. «Авто» переключается само" Margin="0,2,0,2" />
                                <TextBlock Classes="shint" Foreground="#9FD8F5" Text="{Binding TelegramRouteText}" Margin="0,0,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="tgaccess" Content="АВТО" IsChecked="{Binding TelegramAccess, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=0}" />
                                        <RadioButton Classes="seg" GroupName="tgaccess" Content="ПРОКСИ" IsChecked="{Binding TelegramAccess, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=1}" />
                                        <RadioButton Classes="seg" GroupName="tgaccess" Content="НАПРЯМУЮ" IsChecked="{Binding TelegramAccess, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=2}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <StackPanel Classes="sblock">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sname" Text="Опрос каналов" />
                                    <TextBlock Grid.Column="1" Classes="tel" FontSize="12" Foreground="#8C97A7" Text="{Binding PollInterval, StringFormat='{}{0} с'}" />
                                </Grid>
                                <TextBlock Classes="shint" Text="Пауза между запросами к каждому каналу. Чаще — быстрее реакция, но выше риск ограничения со стороны Telegram" Margin="0,2,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="poll" Content="10 С" IsChecked="{Binding PollInterval, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=10}" />
                                        <RadioButton Classes="seg" GroupName="poll" Content="20 С" IsChecked="{Binding PollInterval, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=20}" />
                                        <RadioButton Classes="seg" GroupName="poll" Content="30 С" IsChecked="{Binding PollInterval, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=30}" />
                                        <RadioButton Classes="seg" GroupName="poll" Content="1 МИН" IsChecked="{Binding PollInterval, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=60}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <StackPanel Classes="sblock">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sname" Text="Тревога на карте" />
                                    <TextBlock Grid.Column="1" Classes="tel" FontSize="12" Foreground="#8C97A7" Text="{Binding AlertLifetime, StringFormat='{}{0} мин'}" />
                                </Grid>
                                <TextBlock Classes="shint" Text="Сколько держать тревогу без новых сообщений, если не было отбоя" Margin="0,2,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="alife" Content="30 МИН" IsChecked="{Binding AlertLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=30}" />
                                        <RadioButton Classes="seg" GroupName="alife" Content="45 МИН" IsChecked="{Binding AlertLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=45}" />
                                        <RadioButton Classes="seg" GroupName="alife" Content="1 Ч" IsChecked="{Binding AlertLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=60}" />
                                        <RadioButton Classes="seg" GroupName="alife" Content="1.5 Ч" IsChecked="{Binding AlertLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=90}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <StackPanel Classes="sblock">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sname" Text="Отбой на карте" />
                                    <TextBlock Grid.Column="1" Classes="tel" FontSize="12" Foreground="#8C97A7" Text="{Binding AllClearLifetime, StringFormat='{}{0} мин'}" />
                                </Grid>
                                <TextBlock Classes="shint" Text="Сколько показывать отметку отбоя" Margin="0,2,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="clife" Content="5 МИН" IsChecked="{Binding AllClearLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=5}" />
                                        <RadioButton Classes="seg" GroupName="clife" Content="10 МИН" IsChecked="{Binding AllClearLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=10}" />
                                        <RadioButton Classes="seg" GroupName="clife" Content="15 МИН" IsChecked="{Binding AllClearLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=15}" />
                                        <RadioButton Classes="seg" GroupName="clife" Content="30 МИН" IsChecked="{Binding AllClearLifetime, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=30}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>

                            <!-- УВЕДОМЛЕНИЯ -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="УВЕДОМЛЕНИЯ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Системные уведомления" /><TextBlock Classes="shint" Text="Новые тревоги и повышение уровня — уведомлением операционной системы" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Системные уведомления" IsChecked="{Binding Notifications}" />
                            </Grid>
                            <StackPanel Classes="sblock" IsEnabled="{Binding Notifications}">
                                <TextBlock Classes="sname" Text="Уровень, начиная с которого уведомлять" Margin="0,0,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="nlvl" Content="ВНИМАНИЕ" IsChecked="{Binding NotifyLevelIndex, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=0}" />
                                        <RadioButton Classes="seg" GroupName="nlvl" Content="ОПАСНОСТЬ" IsChecked="{Binding NotifyLevelIndex, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=1}" />
                                        <RadioButton Classes="seg" GroupName="nlvl" Content="ТРЕВОГА" IsChecked="{Binding NotifyLevelIndex, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=2}" />
                                        <RadioButton Classes="seg" GroupName="nlvl" Content="УДАР" IsChecked="{Binding NotifyLevelIndex, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=3}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <!-- зоны наблюдения: регионы, районы и населённые пункты — чипы, поиск со списком, выбор на карте -->
                            <StackPanel Classes="sblock" IsEnabled="{Binding Notifications}">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="sname" Text="Зоны наблюдения" />
                                    <TextBlock Grid.Column="1" Classes="tel" FontSize="12" Foreground="#8C97A7" Text="{Binding NotifyRegionsText}" />
                                </Grid>
                                <TextBlock Classes="shint" Text="Регионы, районы и населённые пункты: уведомлять только о тревогах в них и об угрозах, направленных на них. Ничего не выбрано — по всем" Margin="0,2,0,6" />
                                <ItemsControl ItemsSource="{Binding PickedAreas}" IsVisible="{Binding HasPickedRegions}" Margin="0,0,0,6">
                                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:WatchChoice">
                                            <Button Classes="rchip" Click="RegionChipClick" ToolTip.Tip="Убрать">
                                                <StackPanel Orientation="Horizontal" Spacing="6">
                                                    <TextBlock Classes="rkind" Text="{Binding KindTag}" />
                                                    <TextBlock Text="{Binding Name}" />
                                                    <Path Width="7" Height="7" Stretch="Uniform" Data="M0 0 L8 8 M8 0 L0 8" />
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <!-- без ColumnSpacing: у скрытой «СБРОС» промежуток оставался бы справа от «НА КАРТЕ» -->
                                <Grid ColumnDefinitions="*,Auto,Auto">
                                    <TextBox Classes="search" PlaceholderText="Регион, район или населённый пункт" Text="{Binding RegionSearch}" />
                                    <ToggleButton Grid.Column="1" Margin="6,0,0,0" Classes="rpick" IsChecked="{Binding PickingOnMap}" ToolTip.Tip="Выбрать кликом по карте: регион (на обзоре), район (при приближении) или населённый пункт (по его подписи)">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <Path Width="11" Height="11" Stretch="Uniform" Data="M6 0.5 C3 0.5 1 2.7 1 5.3 C1 8.6 6 13.5 6 13.5 C6 13.5 11 8.6 11 5.3 C11 2.7 9 0.5 6 0.5 Z M6 3.4 A1.9 1.9 0 1 1 5.99 3.4 Z" />
                                            <TextBlock Text="НА КАРТЕ" />
                                        </StackPanel>
                                    </ToggleButton>
                                    <Button Grid.Column="2" Margin="6,0,0,0" Classes="sbtn" Click="ClearRegionsClick" IsVisible="{Binding HasPickedRegions}" ToolTip.Tip="Уведомлять по всем регионам">
                                        <TextBlock Text="СБРОС" />
                                    </Button>
                                </Grid>
                                <Border Classes="rlist">
                                    <Panel>
                                        <ScrollViewer MaxHeight="190" HorizontalScrollBarVisibility="Disabled">
                                            <ItemsControl ItemsSource="{Binding RegionChoicesView}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:WatchChoice">
                                                        <CheckBox Classes="rcheck" IsChecked="{Binding Picked}">
                                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                                <StackPanel>
                                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Classes="rhint" Text="{Binding Hint}" IsVisible="{Binding HasHint}" />
                                                                </StackPanel>
                                                                <TextBlock Grid.Column="1" Classes="rkind" Text="{Binding KindTag}" VerticalAlignment="Center" />
                                                            </Grid>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                        <TextBlock Classes="shint" Text="{Binding SearchHint}" HorizontalAlignment="Center" Margin="0,8" IsHitTestVisible="False" />
                                    </Panel>
                                </Border>
                                <!-- радиус у каждого выбранного пункта: − / значение / + -->
                                <StackPanel IsVisible="{Binding HasPickedPlaces}" Margin="0,10,0,0">
                                    <TextBlock Classes="sname" Text="Радиус вокруг пунктов" />
                                    <TextBlock Classes="shint" Text="Тревоги в пределах этого расстояния от населённого пункта. У каждого пункта — свой; в режиме «на карте» его можно менять, перетаскивая край круга" Margin="0,2,0,6" />
                                    <ItemsControl ItemsSource="{Binding PickedPlaces}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:WatchPlaceRow">
                                                <Grid Classes="prow" ColumnDefinitions="*,Auto,Auto,Auto">
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBox Classes="rename" Text="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" MaxLength="40"
                                                                 ToolTip.Tip="{Binding RenameTip}" KeyDown="RenameKeyDown" />
                                                        <TextBlock Classes="rhint" Text="{Binding Region}" Margin="5,0,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Classes="rstep" Click="RadiusDownClick" IsEnabled="{Binding CanShrink}" ToolTip.Tip="Меньше">
                                                        <Path Width="8" Height="8" Stretch="Uniform" Data="M0 4 H8" />
                                                    </Button>
                                                    <TextBlock Grid.Column="2" Classes="tel" Text="{Binding RadiusText}" FontSize="12" Width="52" TextAlignment="Center" Foreground="#E6F6FF" />
                                                    <Button Grid.Column="3" Classes="rstep" Click="RadiusUpClick" IsEnabled="{Binding CanGrow}" ToolTip.Tip="Больше">
                                                        <Path Width="8" Height="8" Stretch="Uniform" Data="M4 0 V8 M0 4 H8" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,8,0,0">
                                        <TextBlock Classes="shint" Text="Для новых пунктов" VerticalAlignment="Center" Margin="0" />
                                        <Border Grid.Column="1" Classes="fseg" Width="200">
                                            <UniformGrid Rows="1">
                                                <RadioButton Classes="seg" GroupName="wrad" Content="5" IsChecked="{Binding WatchRadiusKm, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=5}" />
                                                <RadioButton Classes="seg" GroupName="wrad" Content="15" IsChecked="{Binding WatchRadiusKm, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=15}" />
                                                <RadioButton Classes="seg" GroupName="wrad" Content="30" IsChecked="{Binding WatchRadiusKm, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=30}" />
                                                <RadioButton Classes="seg" GroupName="wrad" Content="50 КМ" IsChecked="{Binding WatchRadiusKm, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=50}" />
                                            </UniformGrid>
                                        </Border>
                                    </Grid>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14" Margin="0,10,0,0" IsVisible="{Binding HasPickedRegions}">
                                    <StackPanel><TextBlock Classes="sname" Text="Выделять на карте" /><TextBlock Classes="shint" Text="Пунктирный контур выбранных зон, голубой ореол у их тревог и метка «моя зона» в ленте" /></StackPanel>
                                    <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Выделять на карте" IsChecked="{Binding HighlightMyRegions}" />
                                </Grid>
                            </StackPanel>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto" IsEnabled="{Binding Notifications}">
                                <StackPanel><TextBlock Classes="sname" Text="Только в фоне" /><TextBlock Classes="shint" Text="Не уведомлять, пока окно приложения активно" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Только в фоне" IsChecked="{Binding NotifyOnlyInactive}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Потеря и восстановление связи" /><TextBlock Classes="shint" Text="Сообщать, когда каналы перестают отвечать и когда связь возвращается" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Потеря и восстановление связи" IsChecked="{Binding NotifyConnection}" />
                            </Grid>

                            <!-- РАБОТА В ФОНЕ (телефон): служба опроса с постоянным уведомлением -->
                            <StackPanel IsVisible="{Binding IsMobile}">
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*" IsVisible="{Binding CanCast}">
                                <TextBlock Classes="lsec" Text="ВНЕШНИЙ ЭКРАН" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto" IsVisible="{Binding CanCast}">
                                <StackPanel><TextBlock Classes="sname" Text="Трансляция карты" /><TextBlock Classes="shint" Text="{Binding CastText}" /></StackPanel>
                                <Button Grid.Column="1" Classes="sbtn" Classes.amber="{Binding Casting}" Click="CastClick" VerticalAlignment="Center">
                                    <TextBlock Text="ТРАНСЛЯЦИЯ" />
                                </Button>
                            </Grid>
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="РАБОТА В ФОНЕ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Следить в фоне" /><TextBlock Classes="shint" Text="Опрос каналов и оповещения продолжаются, даже когда приложение свёрнуто или закрыто, и после перезагрузки телефона. В шторке — постоянное уведомление «Радар следит за обстановкой»" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Следить в фоне" IsChecked="{Binding BackgroundWatch}" />
                            </Grid>
                            </StackPanel>

                            <!-- ОКНО И ЗАПУСК (десктоп) -->
                            <StackPanel IsVisible="{Binding !IsMobile}">
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ОКНО И ЗАПУСК" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Сворачивать в трей при закрытии" /><TextBlock Classes="shint" Text="Закрытие окна не завершает приложение: опрос и оповещения продолжаются. Выход — в меню значка трея" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Сворачивать в трей при закрытии" IsChecked="{Binding CloseToTray}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Запускать при загрузке системы" /><TextBlock Classes="shint" Text="Автоматически открывать Радар после входа в систему" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Запускать при загрузке системы" IsChecked="{Binding StartWithSystem}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto" IsEnabled="{Binding StartWithSystem}">
                                <StackPanel><TextBlock Classes="sname" Text="Запускать свёрнутым" /><TextBlock Classes="shint" Text="При запуске с системой окно не показывается — приложение сразу уходит в трей" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Запускать свёрнутым" IsChecked="{Binding StartMinimized}" />
                            </Grid>
                            </StackPanel>

                            <!-- ЗВУК -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ЗВУК" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Звуковые оповещения" /><TextBlock Classes="shint" Text="Короткий сигнал при новой тревоге; при «тревоге» и «ударе» — настойчивый" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Звуковые оповещения" IsChecked="{Binding Sound}" />
                            </Grid>
                            <StackPanel Classes="sblock" IsEnabled="{Binding Sound}">
                                <TextBlock Classes="sname" Text="Громкость" Margin="0,0,0,6" />
                                <Border Classes="fseg">
                                    <UniformGrid Rows="1">
                                        <RadioButton Classes="seg" GroupName="svol" Content="ТИХО" IsChecked="{Binding SoundVolume, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=0}" />
                                        <RadioButton Classes="seg" GroupName="svol" Content="СРЕДНЕ" IsChecked="{Binding SoundVolume, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=1}" />
                                        <RadioButton Classes="seg" GroupName="svol" Content="ГРОМКО" IsChecked="{Binding SoundVolume, Converter={x:Static v:EqConverter.Instance}, ConverterParameter=2}" />
                                    </UniformGrid>
                                </Border>
                            </StackPanel>
                            <Button Classes="sbtn" Click="TestNotificationClick" Margin="0,10,0,0" HorizontalAlignment="Stretch">
                                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                                    <Path Width="12" Height="12" Stretch="Uniform" Data="M2 5 H5 L9 1.5 V12.5 L5 9 H2 Z M11 4.5 C12.2 5.7 12.2 8.3 11 9.5" />
                                    <TextBlock Text="ПРОВЕРИТЬ ОПОВЕЩЕНИЕ" />
                                </StackPanel>
                            </Button>

                            <!-- О ПРОГРАММЕ -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="О ПРОГРАММЕ" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Classes="sname" Text="Радар" />
                                        <TextBlock Classes="tel" Text="{Binding AppVersion}" FontSize="12" Foreground="#8C97A7" />
                                    </StackPanel>
                                    <TextBlock Classes="shint" Text="{Binding UpdateCheckText}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <Button Classes="sbtn amber" Click="DownloadUpdateClick" IsVisible="{Binding HasUpdate}">
                                        <TextBlock Text="СКАЧАТЬ" />
                                    </Button>
                                    <Button Classes="sbtn amber" Click="InstallUpdateClick" IsVisible="{Binding CanInstallUpdate}" IsEnabled="{Binding !CheckingUpdates}">
                                        <TextBlock Text="ОБНОВИТЬ" />
                                    </Button>
                                    <Button Classes="sbtn amber" Click="RestartUpdateClick" IsVisible="{Binding UpdateReady}">
                                        <TextBlock Text="ПЕРЕЗАПУСТИТЬ" />
                                    </Button>
                                    <Button Classes="sbtn" Click="CheckUpdatesClick" IsEnabled="{Binding !CheckingUpdates}">
                                        <TextBlock Text="ПРОВЕРИТЬ" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Проверять при запуске" /><TextBlock Classes="shint" Text="Сообщать о новой версии, когда она выйдет" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Проверять при запуске" IsChecked="{Binding CheckUpdates}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto" IsVisible="{Binding CanAutoUpdate}">
                                <StackPanel><TextBlock Classes="sname" Text="Обновлять автоматически" /><TextBlock Classes="shint" Text="Скачивать и ставить новую версию самому — без ручной переустановки" /></StackPanel>
                                <ToggleButton Grid.Column="1" Classes="chsw" AutomationProperties.Name="Обновлять автоматически" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding CheckUpdates}" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Архив сообщений" /><TextBlock Classes="shint" Text="{Binding ArchiveSyncText}" /></StackPanel>
                                <Button Grid.Column="1" Classes="sbtn" Click="SyncArchiveClick" VerticalAlignment="Center">
                                    <TextBlock Text="ОБНОВИТЬ" />
                                </Button>
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto" IsVisible="{Binding CanOpenDataFolder}">
                                <StackPanel><TextBlock Classes="sname" Text="Папка данных" /><TextBlock Classes="shint" Text="settings.json, кеш сообщений и геокодера" /></StackPanel>
                                <Button Grid.Column="1" Classes="sbtn" Click="OpenDataFolderClick" VerticalAlignment="Center">
                                    <TextBlock Text="ОТКРЫТЬ" />
                                </Button>
                            </Grid>

                            <!-- ПОДДЕРЖКА: обратная связь и донат — последними на странице -->
                            <Grid Classes="ssec" ColumnDefinitions="Auto,*">
                                <TextBlock Classes="lsec" Text="ПОДДЕРЖКА" />
                                <Border Grid.Column="1" Classes="lsec" />
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Обратная связь" /><TextBlock Classes="shint" Text="Вопросы, предложения и замечания — в Telegram" /></StackPanel>
                                <Button Grid.Column="1" Classes="sbtn" Click="FeedbackClick" VerticalAlignment="Center">
                                    <TextBlock Text="НАПИСАТЬ" />
                                </Button>
                            </Grid>
                            <Grid Classes="srow" ColumnDefinitions="*,Auto">
                                <StackPanel><TextBlock Classes="sname" Text="Исходный код" /><TextBlock Classes="shint" Text="Проект на GitHub: релизы, история изменений" /></StackPanel>
                                <Button Grid.Column="1" Classes="sbtn" Click="ProjectClick" VerticalAlignment="Center">
                                    <TextBlock Text="ОТКРЫТЬ" />
                                </Button>
                            </Grid>
                            <Button Classes="sbtn donate" Click="DonateClick" HorizontalAlignment="Stretch" Margin="0,12,0,4" AutomationProperties.Name="Поддержать разработчика">
                                <StackPanel Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center">
                                    <Path Width="13" Height="12" Stretch="Uniform" Data="M7 12 L1.6 6.6 C0 5 0 2.4 1.6 1 C3 -0.3 5.2 0 6.4 1.4 L7 2.1 L7.6 1.4 C8.8 0 11 -0.3 12.4 1 C14 2.4 14 5 12.4 6.6 Z" />
                                    <TextBlock Text="ПОДДЕРЖАТЬ РАЗРАБОТЧИКА" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <!-- строка статуса: индикатор и метка состояния, время, каналы, ошибки; полный текст — в подсказке -->
            <Border Grid.Row="2" Classes="statusbar" ToolTip.Tip="{Binding Status}">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*,Auto" Height="26">
                    <Ellipse x:Name="StatusDot" Classes="live" Classes.offline="{Binding IsOffline}" Classes.connecting="{Binding IsConnecting}" Fill="{Binding StatusColor}"
                             Width="6" Height="6" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="1" Classes="stag" Text="{Binding StatusTag}" Foreground="{Binding StatusColor}" />
                    <TextBlock Grid.Column="2" Classes="tel" Text="{Binding StatusTime}" IsVisible="{Binding HasStatusTime}" FontSize="11.5" Foreground="#8C97A7" Margin="8,0,0,0" />
                    <TextBlock Grid.Column="3" Classes="ssub" Text="{Binding StatusChannels}" Margin="10,0,0,0" />
                    <Border Grid.Column="4" Classes="serr" IsVisible="{Binding HasStatusErrors}" Margin="8,0,0,0">
                        <TextBlock Text="{Binding StatusErrors}" />
                    </Border>
                </Grid>
            </Border>
        </Grid>
        </v:GlassPanel>

        <!-- зоны изменения размера окна (своя рамка); в развёрнутом окне скрыты -->
        <Panel Grid.ColumnSpan="2" x:Name="ResizeGrips">
            <Border Background="Transparent" VerticalAlignment="Top" Height="4" Cursor="TopSide" Tag="N" PointerPressed="ResizePressed" />
            <Border Background="Transparent" VerticalAlignment="Bottom" Height="5" Cursor="BottomSide" Tag="S" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Left" Width="5" Cursor="LeftSide" Tag="W" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Right" Width="5" Cursor="RightSide" Tag="E" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Top" Width="10" Height="10" Cursor="TopLeftCorner" Tag="NW" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Top" Width="10" Height="10" Cursor="TopRightCorner" Tag="NE" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="BottomLeftCorner" Tag="SW" PointerPressed="ResizePressed" />
            <Border Background="Transparent" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="12" Height="12" Cursor="BottomRightCorner" Tag="SE" PointerPressed="ResizePressed" />
        </Panel>

        <!-- ===== Режим «Статистика»: дашборд поверх карты (карта — фон с раскраской по интенсивности) ===== -->
        <Grid Grid.ColumnSpan="2" x:Name="StatsBoard" IsVisible="{Binding IsStats}" Margin="0,29,0,0">
            <Grid x:Name="StatsGrid" ColumnDefinitions="*,Auto" ColumnSpacing="10" Margin="12" DataContext="{Binding Stats}" x:DataType="vm:StatsViewModel">
                <!-- шапка дашборда -->
                <v:GlassPanel Grid.ColumnSpan="2" x:Name="StatsHeader" Classes="panel" VerticalAlignment="Top" Padding="16,10,16,10" Tint="#D8070A0E">
                    <Grid x:Name="StatsHeaderGrid" ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="14" RowSpacing="8">
                        <StackPanel Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                            <Ellipse Width="6" Height="6" Fill="#7CD4FF" />
                            <TextBlock Classes="lhead" Text="СТАТИСТИКА" Foreground="#7CD4FF" />
                            <TextBlock x:Name="StatsRangeText" Classes="psub" Text="{Binding RangeText}" VerticalAlignment="Center" Margin="6,0,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" x:Name="StatsRegionBox" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Classes="month" Click="StatsRegionClear" IsVisible="{Binding HasRegion}" ToolTip.Tip="Снять фильтр региона">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding RegionTitle}" FontSize="11.5" Foreground="#9FD8F5" VerticalAlignment="Center" />
                                    <Path Width="7" Height="7" Stretch="Uniform" Stroke="#8C97A7" StrokeThickness="1.2" Data="M0 0 L7 7 M7 0 L0 7" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="StatsRegionHint" Classes="psub" Text="Все регионы · клик по региону на карте — фильтр" IsVisible="{Binding !HasRegion}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" x:Name="StatsPeriodBox" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <!-- свой диапазон: два календаря, пределы — первый и последний день архива -->
                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsCustom}" VerticalAlignment="Center">
                            <CalendarDatePicker Classes="range" SelectedDate="{Binding CustomFrom}" DisplayDateStart="{Binding ArchiveFirstDay}" DisplayDateEnd="{Binding ArchiveLastDay}"
                                                FirstDayOfWeek="Monday" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" PlaceholderText="с" ToolTip.Tip="Первый день периода" />
                            <TextBlock Classes="psub" Text="—" VerticalAlignment="Center" />
                            <CalendarDatePicker Classes="range" SelectedDate="{Binding CustomTo}" DisplayDateStart="{Binding ArchiveFirstDay}" DisplayDateEnd="{Binding ArchiveLastDay}"
                                                FirstDayOfWeek="Monday" SelectedDateFormat="Custom" CustomDateFormatString="dd.MM.yyyy" PlaceholderText="по" ToolTip.Tip="Последний день периода (включительно)" />
                        </StackPanel>
                        <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" MinWidth="200" VerticalAlignment="Center">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatsPeriod"><TextBlock Text="{Binding Title}" FontSize="12" /></DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        </StackPanel>
                    </Grid>
                </v:GlassPanel>

                <!-- загрузка / пусто -->
                <v:GlassPanel Grid.ColumnSpan="2" Classes="panel" IsVisible="{Binding Busy}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" Width="360">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="lhead" Text="{Binding BusyText}" FontSize="12" />
                        <ProgressBar Classes="pbar" Value="{Binding BusyProgress}" Foreground="#7CD4FF" />
                        <TextBlock Classes="psub" Text="Архив прогоняется через движок; итоги месяца сохраняются — повторное открытие мгновенное." TextWrapping="Wrap" />
                    </StackPanel>
                </v:GlassPanel>
                <v:GlassPanel Grid.ColumnSpan="2" Classes="panel" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="18,14" MaxWidth="460">
                    <TextBlock Text="{Binding EmptyText}" TextWrapping="Wrap" FontSize="12.5" Foreground="#DDE6EF" />
                </v:GlassPanel>

                <!-- левая колонка: цифры, по дням, неделя × час; правая — рейтинги -->
                <ScrollViewer Grid.Column="0" x:Name="StatsLeftScroll" Margin="0,64,0,0" IsVisible="{Binding HasData}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatsLeft" Spacing="10">
                        <ItemsControl x:Name="StatsKpis" ItemsSource="{Binding Kpis}" Margin="-5,-5,-5,-5">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{Binding $parent[v:MainView].KpiColumns}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:StatsKpi">
                                    <v:GlassPanel Classes="panel" Margin="5" Padding="14,10" Chamfer="8">
                                        <StackPanel Spacing="2">
                                            <TextBlock Classes="label" Text="{Binding Title}" />
                                            <TextBlock Text="{Binding Value}" FontFamily="avares://Radar.Core/Assets/Fonts#Jura" FontSize="26" FontWeight="SemiBold" Foreground="{Binding Color}" FontFeatures="tnum" />
                                            <TextBlock Classes="psub kpisub" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </v:GlassPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <v:GlassPanel Classes="panel" Padding="16,12">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Classes="lhead" Text="{Binding DaysTitle}" FontSize="12" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="#F5A04A" VerticalAlignment="Center" /><TextBlock Classes="psub" Text="БПЛА" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="#FF6B6B" VerticalAlignment="Center" /><TextBlock Classes="psub" Text="ракеты" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="#C98BFF" VerticalAlignment="Center" /><TextBlock Classes="psub" Text="авиация" /></StackPanel>
                                        <StackPanel Orientation="Horizontal" Spacing="5"><Rectangle Width="8" Height="8" Fill="#7C8A9C" VerticalAlignment="Center" /><TextBlock Classes="psub" Text="прочее" /></StackPanel>
                                    </StackPanel>
                                </Grid>
                                <v:DaysChart Days="{Binding Days}" Height="150" />
                                <TextBlock Classes="psub" Text="{Binding DaysCaption}" />
                            </StackPanel>
                        </v:GlassPanel>
                        <Grid x:Name="StatsWeekRow" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <v:GlassPanel x:Name="StatsWeekPanel" Classes="panel" Padding="16,12">
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="lhead" Text="ДЕНЬ НЕДЕЛИ × ВРЕМЯ СУТОК" FontSize="12" />
                                    <v:WeekHourChart Cells="{Binding WeekHour}" Height="130" />
                                    <TextBlock Classes="psub" Text="{Binding WeekHourCaption}" TextWrapping="Wrap" />
                                </StackPanel>
                            </v:GlassPanel>
                            <v:GlassPanel Grid.Column="1" x:Name="StatsSectorPanel" Classes="panel" Padding="16,12" Width="270">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="lhead" Text="ОТКУДА ЗАХОДЯТ" FontSize="12" />
                                    <v:SectorRose Sectors="{Binding Sectors}" Height="130" />
                                    <ItemsControl ItemsSource="{Binding SectorBars}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,56" Margin="0,3">
                                                <TextBlock Text="{Binding Title}" FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="8,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </v:GlassPanel>
                        </Grid>
                        <Grid x:Name="StatsKindsRow" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                            <v:GlassPanel x:Name="StatsKindsPanel" Classes="panel" Padding="16,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="lhead" Text="ТИПЫ УГРОЗ" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding Kinds}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,124" Margin="0,3">
                                                <!-- название и подпись одной строкой с обрезкой — не наезжают на число -->
                                                <TextBlock FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title}" /><Run Text="  " FontSize="10.5" /><Run Text="{Binding Sub}" FontSize="10.5" Foreground="#6A7686" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="10,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </v:GlassPanel>
                            <v:GlassPanel Grid.Column="1" x:Name="StatsLaunchPanel" Classes="panel" Padding="16,12">
                                <StackPanel Spacing="6">
                                    <TextBlock Classes="lhead" Text="МЕСТА ПУСКОВ" FontSize="12" />
                                    <ItemsControl ItemsSource="{Binding LaunchAreas}" IsVisible="{Binding HasLaunchAreas}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,124" Margin="0,3">
                                                <!-- название и подпись одной строкой с обрезкой — не наезжают на число -->
                                                <TextBlock FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title}" /><Run Text="  " FontSize="10.5" /><Run Text="{Binding Sub}" FontSize="10.5" Foreground="#6A7686" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="10,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="psub" Text="Явные или выведенные по курсу места пусков треков за период." TextWrapping="Wrap" />
                                </StackPanel>
                            </v:GlassPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <ScrollViewer Grid.Column="1" x:Name="StatsRightScroll" Width="400" Margin="0,64,0,0" IsVisible="{Binding HasData}" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="StatsRight" Spacing="10">
                        <v:GlassPanel Classes="panel" Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="lhead" Text="МОИ ЗОНЫ" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding Mine}" IsVisible="{Binding HasMine}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatsMine">
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12" Margin="0,3">
                                                <TextBlock Text="{Binding Name}" FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Classes="pnum" Text="{Binding Count}" Foreground="#E8ECF1" ToolTip.Tip="Тревог" />
                                                <TextBlock Grid.Column="2" Classes="psub" Text="{Binding Hours}" ToolTip.Tip="Суммарно под тревогой" />
                                                <TextBlock Grid.Column="3" Classes="psub" Text="{Binding Median}" ToolTip.Tip="Медианная длительность тревоги" />
                                                <TextBlock Grid.Column="4" Classes="psub" Text="{Binding Closest}" ToolTip.Tip="Ближайшая отметка угрозы" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="psub" IsVisible="{Binding NoMine}" TextWrapping="Wrap"
                                           Text="Зоны наблюдения не выбраны. Выберите регионы, районы или свои пункты в настройках — здесь появится сводка по ним." />
                            </StackPanel>
                        </v:GlassPanel>
                        <v:GlassPanel Classes="panel" Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="lhead" Text="РЕГИОНЫ · ЧИСЛО ТРЕВОГ" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding TopRegions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,124" Margin="0,3">
                                                <!-- название и подпись одной строкой с обрезкой — не наезжают на число -->
                                                <TextBlock FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title}" /><Run Text="  " FontSize="10.5" /><Run Text="{Binding Sub}" FontSize="10.5" Foreground="#6A7686" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="10,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </v:GlassPanel>
                        <v:GlassPanel Classes="panel" Padding="16,12">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="lhead" Text="РЕГИОНЫ · ЧАСОВ ПОД ТРЕВОГОЙ" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding TopRegionsByHours}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,124" Margin="0,3">
                                                <!-- название и подпись одной строкой с обрезкой — не наезжают на число -->
                                                <TextBlock FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title}" /><Run Text="  " FontSize="10.5" /><Run Text="{Binding Sub}" FontSize="10.5" Foreground="#6A7686" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="10,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </v:GlassPanel>
                        <v:GlassPanel Classes="panel" Padding="16,12" IsVisible="{Binding HasPlaces}">
                            <StackPanel Spacing="6">
                                <TextBlock Classes="lhead" Text="НАСЕЛЁННЫЕ ПУНКТЫ" FontSize="12" />
                                <ItemsControl ItemsSource="{Binding TopPlaces}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:StatsBar">
                                            <Grid ColumnDefinitions="*,Auto,124" Margin="0,3">
                                                <!-- название и подпись одной строкой с обрезкой — не наезжают на число -->
                                                <TextBlock FontSize="12" Foreground="#DDE6EF" TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                                                    <Run Text="{Binding Title}" /><Run Text="  " FontSize="10.5" /><Run Text="{Binding Sub}" FontSize="10.5" Foreground="#6A7686" />
                                                </TextBlock>
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" Classes="pnum" FontSize="12" Foreground="#E8ECF1" Margin="10,0" />
                                                <Panel Grid.Column="2" Height="4" VerticalAlignment="Center" Background="#14FFFFFF">
                                                    <Rectangle Width="{Binding BarWidth}" HorizontalAlignment="Left" Fill="{Binding Color}" />
                                                </Panel>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </v:GlassPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
        <!-- меню режимов: клик мимо — закрыть; само меню выезжает из-под заголовка у метки режима -->
        <Border Grid.ColumnSpan="2" x:Name="ModeDismiss" Background="Transparent" Margin="0,29,0,0" IsVisible="{Binding ModeMenuOpen}" PointerPressed="ModeDismissPressed" />
        <Panel Grid.ColumnSpan="2" x:Name="ModeMenu" Classes="modemenu" Classes.open="{Binding ModeMenuOpen}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,29,0,0">
            <v:GlassPanel x:Name="ModeMenuPanel" Chamfer="8" Tint="#EE07090D" Shadow="{StaticResource PanelShadow}" Padding="0,4" Width="300">
                <ItemsControl ItemsSource="{Binding ModeOptions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModeOption">
                            <Button Classes="modeitem" Click="ModeItemClick">
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
                                    <Ellipse Grid.RowSpan="2" Width="6" Height="6" Fill="{Binding Color}" VerticalAlignment="Top" Margin="0,5,10,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{Binding Color}" FontFamily="avares://Radar.Core/Assets/Fonts#Jura"
                                               FontSize="11.5" FontWeight="Bold" LetterSpacing="1.2" />
                                    <TextBlock Grid.Column="1" Grid.Row="1" Text="{Binding Hint}" FontSize="11" Foreground="#8C97A7" Margin="0,2,0,0" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </v:GlassPanel>
        </Panel>
        <!-- тонкая рамка окна; в развёрнутом окне скрыта -->
        <Border Grid.ColumnSpan="2" x:Name="WindowFrame" BorderBrush="#26FFFFFF" BorderThickness="1" IsHitTestVisible="False" />
    </Grid>
</UserControl>
